        "segment_index": 0,
        "relative_start_ms": 18600,
        "relative_end_ms": 21200,
        "type": "action",
        "speaker": null,
        "text": "Catherine's satin-gloved hand clenches tightly into a trembling fist against the folds of her ornate gown."
      },
      {
        "ref": "EP44:E16",
        "segment_index": 0,
        "relative_start_ms": 18800,
        "relative_end_ms": 21200,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Catherine's gloved hand tightening into a fist."
      },
      {
        "ref": "EP44:E17",
        "segment_index": 0,
        "relative_start_ms": 21200,
        "relative_end_ms": 24600,
        "type": "camera",
        "speaker": null,
        "text": "Wide shot as Catherine gathers her heavy train and steps away from Rupert, walking toward Alexander who stands watching her stoically."
      },
      {
        "ref": "EP44:E18",
        "segment_index": 0,
        "relative_start_ms": 22000,
        "relative_end_ms": 24800,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"Alexander... I thought you had died.\""
      },
      {
        "ref": "EP44:E19",
        "segment_index": 0,
        "relative_start_ms": 24600,
        "relative_end_ms": 28000,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Catherine's face, tears glistening in her eyes as grief breaks through her composure."
      },
      {
        "ref": "EP44:E20",
        "segment_index": 0,
        "relative_start_ms": 25200,
        "relative_end_ms": 27800,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"Do you know what this did to me?\""
      },
      {
        "ref": "EP44:E21",
        "segment_index": 0,
        "relative_start_ms": 28000,
        "relative_end_ms": 29200,
        "type": "camera",
        "speaker": null,
        "text": "Medium shot on Alexander standing tall in his ducal coat, his gaze utterly detached."
      },
      {
        "ref": "EP44:E22",
        "segment_index": 0,
        "relative_start_ms": 28000,
        "relative_end_ms": 29200,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"I mourned you.\""
      },
      {
        "ref": "EP44:E23",
        "segment_index": 0,
        "relative_start_ms": 29200,
        "relative_end_ms": 30800,
        "type": "camera",
        "speaker": null,
        "text": "Profile close-up of Catherine as a tear slips down her cheek."
      },
      {
        "ref": "EP44:E24",
        "segment_index": 0,
        "relative_start_ms": 29200,
        "relative_end_ms": 30800,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"I waited for you.\""
      },
      {
        "ref": "EP44:E25",
        "segment_index": 0,
        "relative_start_ms": 30800,
        "relative_end_ms": 32600,
        "type": "camera",
        "speaker": null,
        "text": "Medium shot of Catherine standing in the center of the aisle before the seated congregation."
      },
