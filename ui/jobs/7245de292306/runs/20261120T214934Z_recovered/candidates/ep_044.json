        "ref": "EP44:E26",
        "segment_index": 0,
        "relative_start_ms": 31000,
        "relative_end_ms": 35600,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"For three years, I believed the man I loved was buried somewhere across the sea.\""
      },
      {
        "ref": "EP44:E27",
        "segment_index": 0,
        "relative_start_ms": 32600,
        "relative_end_ms": 35600,
        "type": "camera",
        "speaker": null,
        "text": "Tracking two-shot over Alexander's shoulder as Catherine approaches him pleadingly."
