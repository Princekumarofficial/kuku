        "ref": "EP44:E28",
        "segment_index": 0,
        "relative_start_ms": 35600,
        "relative_end_ms": 38000,
        "type": "camera",
        "speaker": null,
        "text": "Close profile two-shot as Catherine gently reaches her gloved hand up to Alexander's bearded cheek."
      },
      {
        "ref": "EP44:E29",
        "segment_index": 0,
        "relative_start_ms": 35700,
        "relative_end_ms": 38000,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"I never stopped loving you.\""
      },
      {
        "ref": "EP44:E30",
        "segment_index": 0,
        "relative_start_ms": 38000,
        "relative_end_ms": 39600,
        "type": "action",
        "speaker": null,
        "text": "Alexander abruptly pulls his face back, refusing her touch and leaving her hand suspended in mid-air."
      },
      {
        "ref": "EP44:E31",
        "segment_index": 0,
        "relative_start_ms": 38000,
        "relative_end_ms": 39600,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Catherine's empty gloved hand trembling in the empty space between them."
      },
      {
        "ref": "EP44:E32",
        "segment_index": 0,
        "relative_start_ms": 39600,
        "relative_end_ms": 43200,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Catherine lowering her hand, stunned and deeply hurt by his rejection."
      },
      {
        "ref": "EP44:E33",
        "segment_index": 0,
        "relative_start_ms": 41000,
        "relative_end_ms": 43200,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"You don't remember?\""
      },
      {
        "ref": "EP44:E34",
        "segment_index": 0,
        "relative_start_ms": 43200,
        "relative_end_ms": 45800,
        "type": "camera",
        "speaker": null,
        "text": "High-angle shot looking down at Catherine in the foreground, with Rupert held under guard in the background."
      },
      {
        "ref": "EP44:E35",
        "segment_index": 0,
        "relative_start_ms": 43400,
        "relative_end_ms": 45600,
        "type": "dialogue",
        "speaker": "CATHERINE",
        "text": "\"I was supposed to be your Duchess!\""
      },
      {
        "ref": "EP44:E36",
        "segment_index": 0,
        "relative_start_ms": 45800,
        "relative_end_ms": 47800,
        "type": "camera",
        "speaker": null,
        "text": "Medium two-shot of Catherine and Alexander confronting each other."
      },
      {
        "ref": "EP44:E37",
        "segment_index": 0,
        "relative_start_ms": 46000,
        "relative_end_ms": 47800,
        "type": "dialogue",
        "speaker": "ALEXANDER",
        "text": "\"You were never my Duchess.\""
      }
    ]
