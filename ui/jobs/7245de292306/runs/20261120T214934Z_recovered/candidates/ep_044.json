        "relative_start_ms": 100,
        "relative_end_ms": 5000,
        "type": "dialogue",
        "speaker": "POLICE CONSTABLE",
        "text": "\"Lord Henry Sterling, you are under arrest by order of the Crown.\""
      },
      {
        "ref": "EP44:E5",
        "segment_index": 0,
        "relative_start_ms": 5400,
        "relative_end_ms": 8200,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Lord Sterling's trembling, indignant face."
      },
      {
        "ref": "EP44:E6",
        "segment_index": 0,
        "relative_start_ms": 5900,
        "relative_end_ms": 8000,
        "type": "dialogue",
        "speaker": "LORD STERLING",
        "text": "\"You have no authority!\""
      },
      {
        "ref": "EP44:E8",
        "segment_index": 0,
        "relative_start_ms": 8200,
        "relative_end_ms": 10000,
        "type": "dialogue",
        "speaker": "POLICE CONSTABLE",
        "text": "\"I have more than enough.\""
      },
      {
        "ref": "EP44:E7",
        "segment_index": 0,
        "relative_start_ms": 8200,
        "relative_end_ms": 10600,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on the Constable's black-gloved hands holding out a thick, red-ribboned dossier stamped with the Crown's royal wax seal."
      },
      {
        "ref": "EP44:E9",
        "segment_index": 0,
        "relative_start_ms": 10600,
        "relative_end_ms": 13200,
        "type": "camera",
        "speaker": null,
        "text": "Wide shot of the ruined nave littered with rubble as royal redcoat guards surround the aisle, forcing Rupert down onto his knees."
      },
      {
        "ref": "EP44:E10",
        "segment_index": 0,
        "relative_start_ms": 10800,
        "relative_end_ms": 13200,
        "type": "action",
        "speaker": null,
        "text": "A royal redcoat guard firmly forces Rupert down into the stone dust."
      },
      {
        "ref": "EP44:E11",
        "segment_index": 0,
        "relative_start_ms": 10800,
        "relative_end_ms": 13600,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"Get your hands off me! Catherine!\""
      },
      {
        "ref": "EP44:E12",
        "segment_index": 0,
        "relative_start_ms": 13200,
        "relative_end_ms": 16200,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Rupert struggling fiercely against the white-gloved grip of the guard pinning his shoulder."
      },
      {
        "ref": "EP44:E13",
        "segment_index": 0,
        "relative_start_ms": 14200,
        "relative_end_ms": 16100,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"Do something!\""
      },
      {
        "ref": "EP44:E14",
        "segment_index": 0,
        "relative_start_ms": 16200,
        "relative_end_ms": 18800,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up on Catherine beneath her bridal veil, looking downward in conflicted silence."
      },
      {
