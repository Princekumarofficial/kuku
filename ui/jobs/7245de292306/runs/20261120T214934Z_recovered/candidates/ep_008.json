      },
      {
        "ref": "EP08:E19",
        "segment_index": 0,
        "relative_start_ms": 10900,
        "relative_end_ms": 13300,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"You know more about healing than you let on.\""
      },
