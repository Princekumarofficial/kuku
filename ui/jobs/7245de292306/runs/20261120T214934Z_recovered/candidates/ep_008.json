        "segment_index": 0,
        "relative_start_ms": 7800,
        "relative_end_ms": 10400,
        "type": "dialogue",
        "speaker": "ALEXANDER",
        "text": "\"Soldiers learn quickly which plants keep a man alive.\""
      },
      {
        "ref": "EP08:E16",
        "segment_index": 0,
        "relative_start_ms": 7800,
        "relative_end_ms": 10800,
        "type": "camera",
        "speaker": null,
        "text": "Close-up of Alexander speaking in a steady, measured tone."
      },
      {
        "ref": "EP08:E18",
        "segment_index": 0,
        "relative_start_ms": 10800,
        "relative_end_ms": 13000,
        "type": "camera",
