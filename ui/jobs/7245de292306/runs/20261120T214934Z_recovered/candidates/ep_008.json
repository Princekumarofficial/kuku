        "segment_index": 0,
        "relative_start_ms": 14300,
        "relative_end_ms": 15700,
        "type": "dialogue",
        "speaker": "ALEXANDER",
        "text": "\"Enough to survive.\""
      },
      {
        "ref": "EP08:E22",
        "segment_index": 0,
        "relative_start_ms": 15800,
        "relative_end_ms": 18000,
        "type": "camera",
        "speaker": null,
