        "relative_start_ms": 32000,
        "relative_end_ms": 35100,
        "type": "dialogue",
        "speaker": "GERALD",
        "text": "\"You chose that scarred beggar over a life of comfort.\""
      },
      {
        "ref": "EP07:E27",
        "segment_index": 0,
        "relative_start_ms": 35300,
        "relative_end_ms": 42000,
        "type": "camera",
        "speaker": null,
        "text": "Two-shot profile of Juliana looking straight into Gerald's eyes without flinching."
      },
      {
        "ref": "EP07:E28",
        "segment_index": 0,
        "relative_start_ms": 38300,
        "relative_end_ms": 41500,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"I chose a man who stood beside me when you walked away.\""
      },
      {
        "ref": "EP07:E29",
        "segment_index": 0,
        "relative_start_ms": 42000,
        "relative_end_ms": 45700,
        "type": "camera",
        "speaker": null,
        "text": "Intense close-up of Juliana dismissing him with utter contempt."
      },
      {
        "ref": "EP07:E30",
        "segment_index": 0,
        "relative_start_ms": 42300,
        "relative_end_ms": 45300,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"You have no authority here. Leave.\""
      },
      {
        "ref": "EP07:E31",
        "segment_index": 0,
        "relative_start_ms": 45700,
        "relative_end_ms": 50000,
        "type": "camera",
        "speaker": null,
        "text": "Close-up of Gerald lunging forward, aggressively pointing his finger into Juliana's face."
      },
