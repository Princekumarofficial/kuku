        "segment_index": 0,
        "relative_start_ms": 1500,
        "relative_end_ms": 4500,
        "type": "action",
        "speaker": null,
        "text": "Juliana rinses the heavy mud from her hands in a cold rainwater puddle and rises to her feet, holding her head high."
      },
      {
        "ref": "EP07:E9",
        "segment_index": 0,
        "relative_start_ms": 2500,
        "relative_end_ms": 5000,
        "type": "dialogue",
        "speaker": "ARISTOCRATIC WOMAN",
        "text": "\"This is where you live now?\""
      },
      {
        "ref": "EP07:E10",
        "segment_index": 0,
        "relative_start_ms": 5000,
        "relative_end_ms": 10300,
        "type": "camera",
        "speaker": null,
        "text": "Medium shot of Gerald standing beside Aristocratic Woman, sneering disdainfully."
      },
      {
        "ref": "EP07:E11",
        "segment_index": 0,
        "relative_start_ms": 5500,
        "relative_end_ms": 10300,
        "type": "dialogue",
        "speaker": "GERALD",
        "text": "\"A fitting home for a woman who threw away everything for a penniless soldier.\""
      },
      {
        "ref": "EP07:E12",
        "segment_index": 0,
        "relative_start_ms": 10300,
        "relative_end_ms": 13300,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of Juliana, defiant and unflinching despite her soiled dress and damp hair."
      },
      {
        "ref": "EP07:E13",
        "segment_index": 0,
        "relative_start_ms": 10500,
        "relative_end_ms": 13100,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"You came all this way just to insult my home?\""
      },
      {
        "ref": "EP07:E14",
        "segment_index": 0,
        "relative_start_ms": 13300,
        "relative_end_ms": 18000,
        "type": "camera",
        "speaker": null,
        "text": "Close-up of Aristocratic Woman erupting into high-pitched, malicious laughter beneath her parasol."
      },
      {
        "ref": "EP07:E15",
        "segment_index": 0,
        "relative_start_ms": 13700,
        "relative_end_ms": 18300,
        "type": "dialogue",
        "speaker": "ARISTOCRATIC WOMAN",
        "text": "\"Home? Look at your hands, Juliana.\""
      },
      {
        "ref": "EP07:E16",
        "segment_index": 0,
        "relative_start_ms": 18300,
        "relative_end_ms": 20300,
        "type": "camera",
        "speaker": null,
        "text": "Close-up of Juliana's mud-stained palms held open against her apron."
      },
      {
        "ref": "EP07:E17",
        "segment_index": 0,
        "relative_start_ms": 18700,
        "relative_end_ms": 20300,
        "type": "dialogue",
        "speaker": "ARISTOCRATIC WOMAN",
        "text": "\"You look like a servant.\""
      },
      {
        "ref": "EP07:E18",
        "segment_index": 0,
        "relative_start_ms": 20300,
        "relative_end_ms": 21500,
        "type": "camera",
        "speaker": null,
        "text": "Close-up of Gerald's smug expression watching Juliana."
      },
