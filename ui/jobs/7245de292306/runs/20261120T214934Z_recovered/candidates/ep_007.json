        "relative_start_ms": 46100,
        "relative_end_ms": 49000,
        "type": "dialogue",
        "speaker": "GERALD",
        "text": "\"I have enough influence to make a beggar disappear.\""
      },
      {
        "ref": "EP07:E33",
        "segment_index": 0,
        "relative_start_ms": 49100,
        "relative_end_ms": 50000,
        "type": "dialogue",
        "speaker": "GERALD",
        "text": "\"And your husband?\""
      }
