        "segment_index": 0,
        "relative_start_ms": 29300,
        "relative_end_ms": 30900,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"And I remain one.\""
      },
      {
        "ref": "EP07:E25",
        "segment_index": 0,
        "relative_start_ms": 31300,
        "relative_end_ms": 35300,
        "type": "camera",
        "speaker": null,
        "text": "Wide shot framing Juliana facing off against Gerald and Aristocratic Woman in the bleak courtyard."
      },
