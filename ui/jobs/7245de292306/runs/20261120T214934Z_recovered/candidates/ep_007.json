        "segment_index": 0,
        "relative_start_ms": 21500,
        "relative_end_ms": 25500,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of Juliana lifting her chin with unwavering dignity."
      },
      {
        "ref": "EP07:E20",
        "segment_index": 0,
        "relative_start_ms": 21700,
        "relative_end_ms": 25300,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"I work with my hands. There is no shame in that.\""
      },
      {
        "ref": "EP07:E21",
        "segment_index": 0,
        "relative_start_ms": 25500,
        "relative_end_ms": 27500,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Gerald's tightening jaw."
      },
      {
        "ref": "EP07:E22",
        "segment_index": 0,
        "relative_start_ms": 25700,
        "relative_end_ms": 27300,
        "type": "dialogue",
        "speaker": "GERALD",
        "text": "\"You were born a lady.\""
      },
      {
        "ref": "EP07:E23",
        "segment_index": 0,
        "relative_start_ms": 27500,
        "relative_end_ms": 31300,
        "type": "camera",
        "speaker": null,
        "text": "Close-up on Juliana's clear blue eyes, shining with unbroken pride."
