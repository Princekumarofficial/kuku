        "segment_index": 0,
        "relative_start_ms": 3900,
        "relative_end_ms": 7400,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"This man is an imposter! Arrest him!\""
      },
      {
