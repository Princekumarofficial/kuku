        "segment_index": 0,
        "relative_start_ms": 8200,
        "relative_end_ms": 10500,
        "type": "action",
        "speaker": null,
        "text": "Alexander stands completely composed in his dark embroidered aristocratic coat, staring Rupert down with unyielding authority."
      },
      {
        "ref": "EP43:E9",
        "segment_index": 0,
        "relative_start_ms": 10500,
        "relative_end_ms": 13200,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"I said arrest him!\""
      },
