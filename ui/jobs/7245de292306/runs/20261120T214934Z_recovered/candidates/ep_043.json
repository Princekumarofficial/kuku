        "segment_index": 0,
        "relative_start_ms": 8000,
        "relative_end_ms": 10500,
        "type": "camera",
        "speaker": null,
        "text": "Wide symmetrical shot framing Alexander Ashburn standing immovable in the center of the cathedral, flanking lines of red-coated guards on both sides."
