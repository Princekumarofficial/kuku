        "segment_index": 0,
        "relative_start_ms": 600,
        "relative_end_ms": 2400,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"You're lying!\""
      },
      {
        "ref": "EP43:E3",
        "segment_index": 0,
        "relative_start_ms": 2400,
        "relative_end_ms": 3900,
        "type": "action",
        "speaker": null,
        "text": "Rupert lunges forward, his facial features contorting in venomous desperation."
      },
      {
