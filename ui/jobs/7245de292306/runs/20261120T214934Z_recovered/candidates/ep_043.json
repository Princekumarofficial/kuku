        "segment_index": 0,
        "relative_start_ms": 3800,
        "relative_end_ms": 8000,
        "type": "camera",
        "speaker": null,
        "text": "Tracking shot swinging around Rupert as he turns toward the royal guards stationed along the aisle, pointing furiously down the center of the hall."
      },
      {
