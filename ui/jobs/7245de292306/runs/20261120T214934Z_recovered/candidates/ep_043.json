        "segment_index": 0,
        "relative_start_ms": 22000,
        "relative_end_ms": 24000,
        "type": "action",
        "speaker": null,
        "text": "Lord Sterling clutches his gold-headed walking cane tightly, his jaw clenching as tension spreads through the church."
