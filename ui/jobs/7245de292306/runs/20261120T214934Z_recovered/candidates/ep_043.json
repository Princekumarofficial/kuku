        "segment_index": 0,
        "relative_start_ms": 16200,
        "relative_end_ms": 18000,
        "type": "dialogue",
        "speaker": "BLOND NOBLEMAN",
        "text": "\"I am Lord Rupert Ashburn!\""
      },
      {
        "ref": "EP43:E15",
        "segment_index": 0,
        "relative_start_ms": 17800,
        "relative_end_ms": 19200,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up on Rupert thumping his chest in indignant disbelief."
