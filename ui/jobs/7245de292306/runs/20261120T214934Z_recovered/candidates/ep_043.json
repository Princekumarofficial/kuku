        "ref": "EP43:E8",
        "segment_index": 0,
        "relative_start_ms": 10500,
        "relative_end_ms": 13500,
        "type": "camera",
        "speaker": null,
        "text": "Extreme close-up on Rupert's furious face, veins bulging at his temples."
