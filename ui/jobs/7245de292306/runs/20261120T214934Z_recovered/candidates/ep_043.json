        "segment_index": 0,
        "relative_start_ms": 13800,
        "relative_end_ms": 16000,
        "type": "action",
        "speaker": null,
        "text": "The Guard Captain brings his ceremonial sword upright to attention, his expression stern and resolute."
      },
      {
        "ref": "EP43:E12",
        "segment_index": 0,
        "relative_start_ms": 14200,
        "relative_end_ms": 15800,
        "type": "dialogue",
        "speaker": "ROYAL GUARD",
        "text": "\"We will not.\""
      },
      {
        "ref": "EP43:E13",
        "segment_index": 0,
        "relative_start_ms": 16200,
        "relative_end_ms": 17800,
        "type": "camera",
        "speaker": null,
        "text": "Low-angle shot looking down along the polished stone floor as the guard's sword tip grounds firmly between Rupert and the guards."
