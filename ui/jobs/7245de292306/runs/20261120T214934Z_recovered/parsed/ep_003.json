      "delivery": null,
      "source_lines": [
        248,
        250
      ]
    },
    {
      "start_ms": 66000,
      "end_ms": 68100,
      "id": "e_057",
      "scene_id": "sc_003",
      "type": "action",
      "text": "The Bearded Stranger steps deliberately into the aisle, his heavy boots echoing.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        252,
        254
      ]
    },
    {
      "start_ms": 68100,
      "end_ms": 70500,
      "id": "e_058",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Close-up on the Noble Matriarch freezing in utter shock and outrage.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        256,
        258
      ]
    },
    {
      "start_ms": 69900,
      "end_ms": 72100,
      "id": "e_059",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"Take your hands off her.\"",
      "speaker": "THE BEARDED STRANGER",
      "delivery": "Low, Thunderous, Imposing",
      "source_lines": [
        260,
        262
      ]
    },
    {
      "start_ms": 70500,
      "end_ms": 72800,
