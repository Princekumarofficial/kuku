  "events": [
    {
      "start_ms": 0,
      "end_ms": 3500,
      "id": "e_001",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot on Lady Juliana standing abandoned near the altar in her white gown, clutching her mother's medallion to her chest.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        14,
        16
      ]
    },
    {
      "start_ms": 2100,
      "end_ms": 4200,
      "id": "e_002",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Look at you...\"",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": "Mocking, Spiteful",
      "source_lines": [
        18,
        20
      ]
    },
    {
      "start_ms": 3500,
      "end_ms": 6100,
      "id": "e_003",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot on the Lady in Gold Gown, smiling smugly in her gold gown beside Gerald.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        22,
        24
      ]
    },
    {
      "start_ms": 3600,
      "end_ms": 8200,
      "id": "e_004",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"...still clinging to that little locket as if it can make you worthy of a place here.\"",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": "Gloating, Scornful",
      "source_lines": [
        26,
        28
      ]
    },
    {
      "start_ms": 6100,
      "end_ms": 8500,
      "id": "e_005",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up profile of Juliana's hand tightly clutching the jeweled silver locket against her breast, tears welling in her eyes.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        30,
        32
      ]
    },
    {
      "start_ms": 8500,
      "end_ms": 11100,
      "id": "e_006",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up on Juliana looking across at her sister with wounded pride.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 8800,
      "end_ms": 10800,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You stole my wedding.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Hurt, Bitter",
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 11100,
      "end_ms": 13600,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium two-shot of Gerald and the Lady in Gold Gown standing together at the front of the nave.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        42,
        44
      ]
    },
    {
      "start_ms": 11200,
      "end_ms": 13400,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Don't pretend you've earned anything.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Defiant",
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 13600,
      "end_ms": 16400,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the Lady in Gold Gown smirking derisively.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        50,
        52
      ]
    },
    {
      "start_ms": 13800,
      "end_ms": 16300,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I didn't steal what was never truly yours.\"",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": "Smug, Malicious",
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 16400,
      "end_ms": 18600,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up on Juliana's trembling lips, refusing to break down.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 16600,
      "end_ms": 18400,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"This was my wedding.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Trembling, Resolute",
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 18600,
      "end_ms": 20500,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Side medium shot of Gerald looking away impassively as the Lady in Gold Gown leans back against him.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 18700,
      "end_ms": 20400,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"It was supposed to be.\"",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": "Taunting, Cruel",
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 20500,
      "end_ms": 22800,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the Lady in Gold Gown beaming triumphantly.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 20600,
      "end_ms": 22500,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Now it is mine.\"",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": "Vindictive",
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 22800,
      "end_ms": 25800,
      "id": "e_018",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Low-angle wide shot of an imperious Noble Matriarch in a lavish black velvet gown and jeweled tiara stepping forward.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        89,
        91
      ]
    },
    {
      "start_ms": 23100,
      "end_ms": 25500,
      "id": "e_019",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Enough, Juliana.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Harsh, Authoritative",
      "source_lines": [
        93,
        95
      ]
    },
    {
      "start_ms": 25800,
      "end_ms": 28000,
      "id": "e_020",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium close-up of the Noble Matriarch glaring down with icy contempt.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        97,
        99
      ]
    },
    {
      "start_ms": 25900,
      "end_ms": 28000,
      "id": "e_021",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"You have humiliated this family enough for one day.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Cold, Disgusted",
      "source_lines": [
        101,
        103
      ]
    },
    {
      "start_ms": 28000,
      "end_ms": 30300,
      "id": "e_022",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up on Juliana, tears shimmering in her eyes as betrayal strikes deep.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        105,
        107
      ]
    },
    {
      "start_ms": 30300,
      "end_ms": 35500,
      "id": "e_023",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium shot on Juliana as she speaks out against her family's injustice.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        109,
        111
      ]
    },
    {
      "start_ms": 30400,
      "end_ms": 33200,
      "id": "e_024",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"I was humiliated by your family.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Pained, Betrayed",
      "source_lines": [
        113,
        115
      ]
    },
    {
      "start_ms": 33300,
      "end_ms": 35600,
      "id": "e_025",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"And my father said nothing.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Accusing",
      "source_lines": [
        117,
        119
      ]
    },
    {
      "start_ms": 35500,
      "end_ms": 38200,
      "id": "e_026",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium close-up on the Noble Matriarch, completely unsympathetic.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        121,
        123
      ]
    },
    {
      "start_ms": 36500,
      "end_ms": 38400,
      "id": "e_027",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Your father has made his choice.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Brutal, Dismissive",
      "source_lines": [
        125,
        127
      ]
    },
    {
      "start_ms": 38200,
      "end_ms": 40400,
      "id": "e_028",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up on Juliana's stricken, vulnerable face.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        129,
        131
      ]
    },
    {
      "start_ms": 38500,
      "end_ms": 40400,
      "id": "e_029",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"And what happens to me?\"",
      "speaker": "LADY JULIANA",
      "delivery": "Choked, Vulnerable",
      "source_lines": [
        133,
        135
      ]
    },
    {
      "start_ms": 40400,
      "end_ms": 42000,
      "id": "e_030",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up of the Noble Matriarch delivering her verdict.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        137,
        139
      ]
    },
    {
      "start_ms": 40500,
      "end_ms": 41900,
      "id": "e_031",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"You leave.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Cold, Heartless",
      "source_lines": [
        141,
        143
      ]
    },
    {
      "start_ms": 42000,
      "end_ms": 43300,
      "id": "e_032",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up on Juliana blinking in disbelief.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        145,
        147
      ]
    },
    {
      "start_ms": 42100,
      "end_ms": 43300,
      "id": "e_033",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Leave where?\"",
      "speaker": "LADY JULIANA",
      "delivery": "Disbelieving",
      "source_lines": [
        149,
        151
      ]
    },
    {
      "start_ms": 43300,
      "end_ms": 45900,
      "id": "e_034",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium shot of the Noble Matriarch looking down her nose in disdain.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        153,
        155
      ]
    },
    {
      "start_ms": 43400,
      "end_ms": 46000,
      "id": "e_035",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Wherever a discarded daughter belongs.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Cruel, Scornful",
      "source_lines": [
        157,
        159
      ]
    },
    {
      "start_ms": 45900,
      "end_ms": 48800,
      "id": "e_036",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Low-angle close-up focusing on Juliana's neck as her fingers desperately clutch the oval locket.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        161,
        163
      ]
    },
    {
      "start_ms": 46400,
      "end_ms": 48600,
      "id": "e_037",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"This is my mother's church.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Fierce, Choked",
      "source_lines": [
        165,
        167
      ]
    },
    {
      "start_ms": 48800,
      "end_ms": 51200,
      "id": "e_038",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up on Juliana's face, teeth clenched in desperate defiance.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        169,
        171
      ]
    },
    {
      "start_ms": 48900,
      "end_ms": 51100,
      "id": "e_039",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"I have every right to stand here.\"",
      "speaker": "LADY JULIANA",
      "delivery": "Defiant, Firm",
      "source_lines": [
        173,
        175
      ]
    },
    {
      "start_ms": 51200,
      "end_ms": 53000,
      "id": "e_040",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Tight close-up of the Noble Matriarch leaning in with vicious delight.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        177,
        179
      ]
    },
    {
      "start_ms": 51300,
      "end_ms": 53000,
      "id": "e_041",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Not anymore.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Venomous",
      "source_lines": [
        181,
        183
      ]
    },
    {
      "start_ms": 53000,
      "end_ms": 56200,
      "id": "e_042",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium shot on the Noble Matriarch gesturing expansively to the filled cathedral nave behind her.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        185,
        187
      ]
    },
    {
      "start_ms": 53300,
      "end_ms": 56200,
      "id": "e_043",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Your father has chosen his family...\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Stern, Final",
      "source_lines": [
        189,
        191
      ]
    },
    {
      "start_ms": 56200,
      "end_ms": 58200,
      "id": "e_044",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up profile of the Noble Matriarch's piercing eyes glaring directly at Juliana.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        193,
        195
      ]
    },
    {
      "start_ms": 56300,
      "end_ms": 58200,
      "id": "e_045",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"...and it isn't you.\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Coldly Severing",
      "source_lines": [
        197,
        199
      ]
    },
