      "delivery": null,
      "source_lines": [
        201,
        203
      ]
    },
    {
      "start_ms": 58300,
      "end_ms": 60000,
      "id": "e_047",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Guards! Remove her!\"",
      "speaker": "NOBLE MATRIARCH",
      "delivery": "Shouting, Imperious",
      "source_lines": [
        205,
        207
      ]
    },
    {
      "start_ms": 60000,
      "end_ms": 62000,
      "id": "e_048",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Medium shot as two royal guards in red uniforms and bearskin caps step in behind Juliana and seize her arms.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        209,
        211
      ]
    },
    {
      "start_ms": 60500,
      "end_ms": 62500,
      "id": "e_049",
      "scene_id": "sc_002",
      "type": "action",
      "text": "The guards forcefully grab Juliana by both shoulders and drag her backwards.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        213,
        215
      ]
    },
    {
      "start_ms": 60600,
      "end_ms": 62300,
      "id": "e_050",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Let me go!\"",
      "speaker": "LADY JULIANA",
      "delivery": "Screaming, Resisting",
      "source_lines": [
        217,
        219
      ]
    },
    {
      "start_ms": 62000,
      "end_ms": 63200,
      "id": "e_051",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Close-up of Juliana's hand frantically grabbing the wooden rim of a pew, knuckles white with strain.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        221,
        223
      ]
    },
    {
      "start_ms": 62400,
      "end_ms": 63500,
      "id": "e_052",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Please! Someone!\"",
      "speaker": "LADY JULIANA",
      "delivery": "Desperate, Begging",
      "source_lines": [
        225,
        227
      ]
    },
    {
      "start_ms": 63000,
      "end_ms": 64500,
      "id": "e_053",
      "scene_id": "sc_002",
      "type": "action",
      "text": "The guards tear her grip away from the pew.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        229,
        231
      ]
    },
    {
