      "delivery": null,
      "source_lines": [
        86,
        88
      ]
    },
    {
      "start_ms": 35200,
      "end_ms": 37600,
      "id": "e_020",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"My lost son wore that ring!\"",
      "speaker": "DOWAGER DUCHESS",
      "delivery": "Desperate, Clinging",
      "source_lines": [
        90,
        92
