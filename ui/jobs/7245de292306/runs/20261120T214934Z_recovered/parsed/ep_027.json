      "start_ms": 41000,
      "end_ms": 44200,
      "id": "e_023",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"He never spoke of his officers. He only spoke of survival.\"",
      "speaker": "JULIANA",
      "delivery": "Soft, Reverent",
      "source_lines": [
        102,
        104
      ]
    },
    {
      "start_ms": 44200,
      "end_ms": 46400,
      "id": "e_024",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the Duchess gazing up at Juliana, her voice barely a whisper.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        106,
        108
      ]
    },
    {
      "start_ms": 44500,
      "end_ms": 46400,
      "id": "e_025",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"What is your husband's name?\"",
      "speaker": "DOWAGER DUCHESS",
      "delivery": "Hushed, Desperate",
      "source_lines": [
        110,
        112
      ]
