      "id": "e_055",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of the Blond Nobleman pacing forward with calculating malice.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        230,
        232
      ]
    },
