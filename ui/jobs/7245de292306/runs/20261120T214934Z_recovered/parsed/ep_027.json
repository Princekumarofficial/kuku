      "end_ms": 16800,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana, trying to keep her composure.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 13400,
      "end_ms": 16400,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"He is a soldier. A veteran from the Peninsula.\"",
      "speaker": "JULIANA",
      "delivery": "Earnest, Defending",
      "source_lines": [
        50,
        52
      ]
