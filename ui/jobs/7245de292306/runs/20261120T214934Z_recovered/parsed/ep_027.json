      "delivery": null,
      "source_lines": [
        22,
        24
      ]
    },
    {
      "start_ms": 3400,
      "end_ms": 5800,
      "id": "e_004",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Look at me, girl. Who gave this to you?\"",
      "speaker": "DOWAGER DUCHESS",
