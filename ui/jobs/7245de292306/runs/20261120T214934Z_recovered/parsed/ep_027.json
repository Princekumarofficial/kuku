    {
      "start_ms": 16800,
      "end_ms": 21600,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium two-shot as the Duchess leans forward slightly, staring at the ring between their joined hands.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 17200,
      "end_ms": 21200,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"That is no ordinary band. It bears the Ashbourne crest.\"",
      "speaker": "DOWAGER DUCHESS",
