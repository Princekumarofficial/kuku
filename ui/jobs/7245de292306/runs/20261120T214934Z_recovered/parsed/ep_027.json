      "source_lines": [
        26,
        28
      ]
    },
    {
      "start_ms": 5800,
      "end_ms": 9400,
      "id": "e_005",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Juliana in her maid's apron, startled and anxious as she answers.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        30,
        32
      ]
    },
    {
      "start_ms": 6400,
      "end_ms": 9300,
      "id": "e_006",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"My husband. He gave it to me when we wed.\"",
      "speaker": "JULIANA",
      "delivery": "Hesitant, Sincere",
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 9400,
      "end_ms": 13200,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low angle on the Dowager Duchess, her eyes burning with intensity.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 9700,
      "end_ms": 12800,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"He is no commoner. What does he do?\"",
      "speaker": "DOWAGER DUCHESS",
      "delivery": "Incredulous, Intense",
      "source_lines": [
        42,
        44
