    },
    {
      "start_ms": 80800,
      "end_ms": 83000,
      "id": "e_049",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana holding her ground.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        206,
        208
      ]
    },
    {
      "start_ms": 81000,
      "end_ms": 82000,
      "id": "e_050",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No one.\"",
      "speaker": "JULIANA",
      "delivery": "Quiet, Resolute",
