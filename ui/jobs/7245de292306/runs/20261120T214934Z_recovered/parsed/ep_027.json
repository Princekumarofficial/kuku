      "start_ms": 62200,
      "end_ms": 63500,
      "id": "e_037",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Nothing.\"",
      "speaker": "JULIANA",
      "delivery": "Firm",
      "source_lines": [
