      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 21600,
      "end_ms": 26100,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up on Juliana, shaking her head in disbelief and growing confusion.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 21800,
      "end_ms": 25800,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No. He lives in a barn. He has nothing but his word.\"",
      "speaker": "JULIANA",
      "delivery": "Confused, Gentle",
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 26100,
      "end_ms": 31800,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot on the Duchess, tears welling in her eyes as grief and shock overtake her.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 26600,
      "end_ms": 31400,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"My lost son wore that exact ring. He went to war...\"",
      "speaker": "DOWAGER DUCHESS",
      "delivery": "Emotionally Strained, Weeping",
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 31800,
      "end_ms": 34900,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana's eyes widening in stunned revelation.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 32100,
      "end_ms": 34800,
      "id": "e_018",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Your son? He told me he was only a sergeant.\"",
      "speaker": "JULIANA",
      "delivery": "Shocked, Breathless",
      "source_lines": [
        82,
        84
      ]
    },
    {
      "start_ms": 34900,
      "end_ms": 37400,
      "id": "e_019",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Side-angle medium shot of the bed, the Duchess holding onto Juliana's forearm with fierce insistence.",
