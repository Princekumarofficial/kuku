      "source_lines": [
        18,
        20
      ]
    },
    {
      "start_ms": 2100,
      "end_ms": 5800,
      "id": "e_003",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle medium close-up of the Dowager Duchess lying propped against her pillows, gripping Juliana's wrist firmly as she gazes up in desperate demand.",
