      "heading": "INT. CASTLE SUBTERRANEAN WET CELLS – NIGHT"
    }
  ],
  "events": [
    {
      "start_ms": 0,
      "end_ms": 2800,
      "id": "e_001",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Static medium shot of the heavy, iron-studded dungeon door as the massive bolt loudly slides open.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        14,
        16
      ]
    },
    {
      "start_ms": 0,
      "end_ms": 2800,
      "id": "e_002",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "Heavy iron latch sliding back with an ominous, echoing metallic clang, followed by the deep groaning creak of the cell door swinging inward.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        18,
        20
      ]
    },
    {
      "start_ms": 2800,
      "end_ms": 4200,
      "id": "e_003",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Juliana huddled against the stone wall, bound in heavy iron chains, shivering in her torn apron and lifting her tear-streaked face in dread.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        22,
        24
      ]
    },
    {
      "start_ms": 2800,
      "end_ms": 4200,
      "id": "e_004",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana recoils against the damp stonework, her eyes wide with terror as light floods into the dark cell.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        26,
        28
      ]
    },
    {
      "start_ms": 4200,
      "end_ms": 9500,
      "id": "e_005",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Full shot framed through the arched doorway. Catherine stands imperiously in an ornate, gold-embroidered violet gown, holding a smoldering hot poker and a charred leather-bound book, flanked by two stone-faced guards with lanterns.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        30,
        32
      ]
    },
    {
      "start_ms": 6900,
      "end_ms": 8800,
      "id": "e_006",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Look at you.\"",
      "speaker": "CATHERINE",
      "delivery": "Cruel, Condescending",
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 9500,
      "end_ms": 10500,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle close-up of Juliana looking up from the stone floor, her gaze hardening despite her fear.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 10500,
      "end_ms": 13800,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Tight close-up of Catherine's face, bathed in the orange flickering glow of the red-hot branding iron, smiling with pure malice.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        42,
        44
      ]
    },
    {
      "start_ms": 10500,
      "end_ms": 13800,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"The great Lady Juliana Ashcroft.\"",
      "speaker": "CATHERINE",
      "delivery": "Mocking, Venomous",
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 13800,
      "end_ms": 17600,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Over-the-shoulder wide shot past Catherine looking down at Juliana shackled helplessly on the wet stone floor.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        50,
        52
      ]
    },
    {
      "start_ms": 14000,
      "end_ms": 17600,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Chained in a dungeon like a common criminal.\"",
      "speaker": "CATHERINE",
      "delivery": "Taunting",
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 17600,
      "end_ms": 20800,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana, her eyes glistening with unshed tears, speaking with quiet defiance.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 17800,
      "end_ms": 20500,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You seem very pleased.\"",
      "speaker": "JULIANA",
      "delivery": "Defiant, Steady",
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 20800,
      "end_ms": 24500,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot looking up at Catherine towering over Juliana, holding the glowing poker at her side.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 21000,
      "end_ms": 23500,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I am.\"",
      "speaker": "CATHERINE",
      "delivery": "Smug, Chilling",
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 24500,
      "end_ms": 29000,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Extreme close-up of the bent, white-hot tip of the poker radiating heat, with Catherine's face blurred in the background as she gazes down with predatory pleasure.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 25000,
      "end_ms": 28900,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Because this is what you were always meant to be.\"",
      "speaker": "CATHERINE",
      "delivery": "Whispering, Sinister",
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 29000,
      "end_ms": 34800,
      "id": "e_018",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Over-the-shoulder medium shot focusing on Juliana as Catherine presents the charred, singed pages of the botanical book.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        82,
        84
      ]
    },
    {
      "start_ms": 29300,
      "end_ms": 34800,
      "id": "e_019",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Your family dressed you like a lady. They educated you. They gave you a respectable name.\"",
      "speaker": "CATHERINE",
      "delivery": "Scornful",
      "source_lines": [
        86,
        88
      ]
    },
    {
      "start_ms": 34800,
      "end_ms": 39000,
      "id": "e_020",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Catherine's face breaking into an arrogant, haughty laugh.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        90,
        92
      ]
    },
    {
      "start_ms": 35000,
      "end_ms": 38900,
      "id": "e_021",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"[chuckles] And still you became a disgrace.\"",
      "speaker": "CATHERINE",
      "delivery": "Amused, Spiteful",
      "source_lines": [
        94,
        96
      ]
    },
    {
      "start_ms": 39000,
      "end_ms": 43000,
      "id": "e_022",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Tight close-up of Juliana's fierce, unwavering gaze as she retorts without hesitation.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        98,
        100
      ]
    },
    {
      "start_ms": 39200,
      "end_ms": 43000,
      "id": "e_023",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I became a disgrace when I refused to become cruel.\"",
      "speaker": "JULIANA",
      "delivery": "Fierce, Unbroken",
      "source_lines": [
        102,
        104
      ]
    },
    {
      "start_ms": 43000,
      "end_ms": 48500,
      "id": "e_024",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Catherine scowling, cutting back to a shot of Juliana's bare, chained feet locked in iron manacles against the cold stone floor.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        106,
        108
      ]
    },
    {
      "start_ms": 43200,
      "end_ms": 48500,
      "id": "e_025",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No. You became a disgrace when Gerald left you standing at the altar.\"",
      "speaker": "CATHERINE",
      "delivery": "Cold, Bitter",
      "source_lines": [
        110,
        112
      ]
    },
    {
      "start_ms": 48500,
      "end_ms": 54800,
      "id": "e_026",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot from floor level looking up at Catherine leaning closer, savoring Juliana's humiliation.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        114,
        116
      ]
    },
    {
      "start_ms": 48900,
      "end_ms": 50800,
      "id": "e_027",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Do you remember?\"",
      "speaker": "CATHERINE",
      "delivery": "Gloating",
      "source_lines": [
        118,
        120
      ]
    },
    {
      "start_ms": 49000,
      "end_ms": 52000,
      "id": "e_028",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana stares up, her breathing steadying as she refuses to break under Catherine's barbs.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        122,
        124
      ]
    },
    {
      "start_ms": 51000,
      "end_ms": 54800,
      "id": "e_029",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Everyone saw you. Everyone watched him chose Clarisse.\"",
      "speaker": "CATHERINE",
      "delivery": "Viciously Delighted",
      "source_lines": [
        126,
        128
      ]
    },
    {
      "start_ms": 54800,
      "end_ms": 59000,
      "id": "e_030",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the red-hot iron hovering over the damp stone floor, rising steam and heat waves warping the air, before cutting to Catherine's gloating expression.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        130,
        132
      ]
    },
    {
      "start_ms": 55200,
      "end_ms": 57500,
      "id": "e_031",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "Faint sizzling and hissing as ambient moisture touches the scalding iron tip.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        134,
        136
      ]
    },
    {
      "start_ms": 55500,
      "end_ms": 58800,
      "id": "e_032",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"And everyone watched you walk away alone.\"",
      "speaker": "CATHERINE",
      "delivery": "Quietly Venomous",
      "source_lines": [
        138,
        140
      ]
    },
    {
      "start_ms": 59000,
      "end_ms": 65500,
      "id": "e_033",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up pushing in on Juliana's illuminated, dignified face.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        142,
        144
      ]
    },
    {
      "start_ms": 59200,
      "end_ms": 61300,
      "id": "e_034",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Gerald chose money.\"",
      "speaker": "JULIANA",
      "delivery": "Proud, Measured",
      "source_lines": [
        146,
        148
      ]
    },
    {
      "start_ms": 61500,
      "end_ms": 63500,
      "id": "e_035",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Clarissa chose a coward.\"",
      "speaker": "JULIANA",
      "delivery": "Resolute",
      "source_lines": [
        150,
        152
      ]
    },
    {
      "start_ms": 63800,
      "end_ms": 65300,
      "id": "e_036",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I chose myself.\"",
      "speaker": "JULIANA",
      "delivery": "Unyielding",
      "source_lines": [
        154,
        156
      ]
    },
    {
      "start_ms": 65500,
      "end_ms": 67500,
      "id": "e_037",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Catherine's face tightening in disgust.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        158,
        160
      ]
    },
    {
      "start_ms": 65600,
      "end_ms": 67400,
      "id": "e_038",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You chose a beggar.\"",
      "speaker": "CATHERINE",
      "delivery": "Disgusted",
      "source_lines": [
        162,
        164
      ]
    },
    {
      "start_ms": 67500,
      "end_ms": 70500,
      "id": "e_039",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot of Juliana lifting her chin with unwavering pride.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        166,
        168
      ]
    },
    {
      "start_ms": 67600,
      "end_ms": 69800,
      "id": "e_040",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I chose a man.\"",
      "speaker": "JULIANA",
      "delivery": "Fierce, Proud",
      "source_lines": [
        170,
        172
      ]
    },
    {
      "start_ms": 70500,
      "end_ms": 73300,
      "id": "e_041",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Catherine sneering down at her.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        174,
        176
      ]
    },
    {
      "start_ms": 70800,
      "end_ms": 73200,
      "id": "e_042",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A scarred nobody.\"",
      "speaker": "CATHERINE",
      "delivery": "Contemptuous",
      "source_lines": [
        178,
        180
      ]
    },
    {
      "start_ms": 73300,
      "end_ms": 77600,
      "id": "e_043",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Juliana sitting erect against the dungeon wall, her hands resting calmly in her lap.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        182,
        184
      ]
    },
    {
      "start_ms": 73500,
      "end_ms": 77600,
      "id": "e_044",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A man with more honor than the people sitting above this dungeon.\"",
      "speaker": "JULIANA",
      "delivery": "Resolute, Dignified",
      "source_lines": [
        186,
        188
      ]
    },
    {
      "start_ms": 77600,
      "end_ms": 80500,
      "id": "e_045",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Catherine, holding the smoldering iron between them.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        190,
        192
      ]
    },
    {
      "start_ms": 77800,
      "end_ms": 80200,
      "id": "e_046",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You call that marriage?\"",
      "speaker": "CATHERINE",
      "delivery": "Incredulous, Mocking",
      "source_lines": [
        194,
        196
      ]
    },
    {
      "start_ms": 80500,
      "end_ms": 83200,
      "id": "e_047",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Extreme close-up of Juliana's clear blue eyes, shining with profound conviction.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        198,
        200
      ]
    },
    {
      "start_ms": 80800,
      "end_ms": 83200,
      "id": "e_048",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I call it love.\"",
      "speaker": "JULIANA",
      "delivery": "Pure, Sincere",
      "source_lines": [
        202,
        204
      ]
    },
    {
      "start_ms": 83200,
      "end_ms": 88000,
      "id": "e_049",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "High-angle wide shot looking straight down through the ceiling iron grating into the deep dungeon shaft where Catherine looms over Juliana.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        206,
        208
      ]
    },
    {
      "start_ms": 83500,
      "end_ms": 87400,
      "id": "e_050",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"[laughs] Love? Look where your precious love brought you.\"",
      "speaker": "CATHERINE",
      "delivery": "Mocking, Hysterical Laugh",
      "source_lines": [
        210,
        212
      ]
    },
    {
      "start_ms": 87500,
      "end_ms": 91200,
      "id": "e_051",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Juliana looking directly up past the glowing tip of the iron poker into Catherine's eyes.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        214,
        216
      ]
    },
    {
      "start_ms": 87800,
      "end_ms": 91200,
      "id": "e_052",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"To a place where I can still look you in the eyes.\"",
      "speaker": "JULIANA",
      "delivery": "Firm, Piercing",
      "source_lines": [
        218,
        220
      ]
    },
    {
      "start_ms": 91200,
      "end_ms": 94200,
      "id": "e_053",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Catherine, her lips curling in indignant disbelief.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        222,
        224
      ]
    },
    {
      "start_ms": 91400,
      "end_ms": 94200,
      "id": "e_054",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You think love makes you better than me?\"",
      "speaker": "CATHERINE",
      "delivery": "Incredulous, Offended",
      "source_lines": [
        226,
        228
      ]
    },
    {
      "start_ms": 94200,
      "end_ms": 98200,
      "id": "e_055",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana speaking calmly and razor-sharp.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        230,
        232
      ]
    },
    {
      "start_ms": 94500,
      "end_ms": 98200,
      "id": "e_056",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No. But cruelty certainly doesn't make you better than me.\"",
      "speaker": "JULIANA",
      "delivery": "Calm, Cutting",
      "source_lines": [
        234,
        236
      ]
    },
    {
      "start_ms": 98200,
      "end_ms": 103500,
      "id": "e_057",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Catherine sweeping her arm out, flaunting her aristocratic privilege and opulence.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        238,
        240
      ]
    },
    {
      "start_ms": 98500,
      "end_ms": 103300,
      "id": "e_058",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I have beauty, money, family, status! What do you have?\"",
      "speaker": "CATHERINE",
      "delivery": "Incensed, Boastful",
      "source_lines": [
        242,
        244
      ]
    },
    {
      "start_ms": 103500,
      "end_ms": 108800,
      "id": "e_059",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana, her expression serene and grounded in moral superiority.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        246,
        248
      ]
    },
    {
      "start_ms": 103700,
