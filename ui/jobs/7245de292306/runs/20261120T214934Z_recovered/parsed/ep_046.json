  ],
  "events": [
    {
      "start_ms": 0,
      "end_ms": 3500,
      "id": "e_001",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Full shot of Alexander and Juliana standing side by side before the altar, their hands tightly clasped beneath the soaring stained-glass windows.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        14,
        16
      ]
    },
    {
      "start_ms": 0,
      "end_ms": 3500,
      "id": "e_002",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Alexander holds Juliana's hand resolutely as Juliana gazes toward the church aisle where the intrusion unfolds.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        18,
        20
      ]
    },
    {
      "start_ms": 3500,
      "end_ms": 5800,
      "id": "e_003",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of an elderly noblewoman seated in the pew, clutching her chest with anxious apprehension.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        22,
        24
      ]
    },
    {
      "start_ms": 5800,
      "end_ms": 7100,
      "id": "e_004",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Catherine in her lavish bridal gown, her fists clenched tightly in silent fury.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        26,
        28
      ]
    },
    {
      "start_ms": 7100,
      "end_ms": 11000,
      "id": "e_005",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide tracking shot down the ruined nave aisle as the High Priest marches forward flanked by armed royal guards with halberds.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        30,
        32
      ]
    },
    {
      "start_ms": 7800,
      "end_ms": 11000,
      "id": "e_006",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "Heavy armored footsteps and boots crunching against loose stone debris.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 11000,
      "end_ms": 13800,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of the High Priest holding up a wax-sealed document before his chest, flanked by two armed guards.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 11500,
      "end_ms": 16800,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"By Royal command, this sanctuary is placed under immediate Crown scesion.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Booming, Authoritative",
      "source_lines": [
        42,
        44
      ]
    },
    {
      "start_ms": 13800,
      "end_ms": 17200,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the High Priest's fingers breaking the crimson wax seal and string on the war office envelope.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 15000,
      "end_ms": 16800,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "Crisp tear of wax and parchment string snapping open.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        50,
        52
      ]
    },
    {
      "start_ms": 17200,
      "end_ms": 20500,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle medium shot of the High Priest opening the yellowed War Office document.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 17300,
      "end_ms": 20400,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"None shall leave until every witness is accounted for.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Stern, Commanding",
      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 20500,
      "end_ms": 22800,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide shot of Alexander and Juliana standing defiant at the altar as congregation members watch in silence.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 20600,
      "end_ms": 22800,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You married this woman as a nameless beggar...\"",
      "speaker": "HIGH PRIEST",
      "delivery": "O.S.) (Cold, Accusatory",
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 22800,
      "end_ms": 26800,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of the High Priest holding the decree, his gaze burning with disdain.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 22900,
      "end_ms": 26500,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"...in a hedge ceremony no clerk in England ever recorded.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Scornful, Harsh",
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 26800,
      "end_ms": 30500,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Full shot of the High Priest brandishing the letter aloft in the center of the chapel nave.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 26800,
      "end_ms": 31800,
      "id": "e_018",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Three years later, the beggar is revealed to be a Duke. The marriage does not rise with him.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Resonant, Dismissive",
      "source_lines": [
        82,
        84
      ]
    },
    {
      "start_ms": 30500,
      "end_ms": 34200,
      "id": "e_019",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Alexander turning toward Juliana, placing a protective hand on her arm.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        86,
        88
      ]
    },
    {
      "start_ms": 32500,
      "end_ms": 34500,
      "id": "e_020",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana places her hand over Alexander's as he steps forward to shield her.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        90,
        92
      ]
    },
    {
      "start_ms": 34200,
      "end_ms": 37000,
      "id": "e_021",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Alexander, his scarred face hardening with unwavering conviction.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        94,
        96
      ]
    },
    {
      "start_ms": 34300,
      "end_ms": 36700,
      "id": "e_022",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"She married the man... not the title.\"",
      "speaker": "ALEXANDER",
      "delivery": "Gravely, Firm",
      "source_lines": [
        98,
        100
      ]
    },
    {
      "start_ms": 37000,
      "end_ms": 42800,
      "id": "e_023",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot looking up at the High Priest as he raises the parchment toward the vaulted ceiling.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        102,
        104
      ]
    },
    {
      "start_ms": 37300,
      "end_ms": 42500,
      "id": "e_024",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"The church married a vagrant to a ruined lady. It never married the Duke of Ashburton to anyone.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Harsh, Derisive",
      "source_lines": [
        106,
        108
      ]
    },
    {
      "start_ms": 42800,
      "end_ms": 47000,
      "id": "e_025",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of the High Priest lowering the document, raising a single finger in admonishment.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        110,
        112
      ]
    },
    {
      "start_ms": 42800,
      "end_ms": 47000,
      "id": "e_026",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No Crown license was sought, because no one thought to ask leave for a Duke to marry.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Rigid, Formal",
      "source_lines": [
        114,
        116
      ]
    },
    {
      "start_ms": 47000,
      "end_ms": 49000,
      "id": "e_027",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Two-shot of Juliana and Alexander listening intently, Juliana's eyes flashing with hurt and defiance.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        118,
        120
      ]
    },
    {
      "start_ms": 47100,
      "end_ms": 49000,
      "id": "e_028",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No licensed clergyman presided...\"",
      "speaker": "HIGH PRIEST",
      "delivery": "O.S.) (Sharp",
      "source_lines": [
        122,
        124
      ]
    },
    {
      "start_ms": 49000,
      "end_ms": 52200,
      "id": "e_029",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the High Priest glaring intently.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        126,
        128
      ]
    },
    {
      "start_ms": 49000,
      "end_ms": 52200,
      "id": "e_030",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"...because a frightened village priest has no authority to bind a peer.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Scathing",
      "source_lines": [
        130,
        132
      ]
    },
    {
      "start_ms": 52200,
      "end_ms": 58200,
      "id": "e_031",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot pushing into a close-up as the High Priest thrusts the royal War Office proclamation directly into the camera.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        134,
        136
      ]
    },
    {
      "start_ms": 52200,
      "end_ms": 58000,
      "id": "e_032",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"And no clerk in London ever entered your name in the Royal register, because as far as the Crown knew, Alexander Ashburton was already dead.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Thundering",
      "source_lines": [
        138,
        140
      ]
    },
    {
      "start_ms": 58200,
      "end_ms": 62800,
      "id": "e_033",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana lifting her chin, tearful yet burning with righteous fury.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        142,
        144
      ]
    },
    {
      "start_ms": 58500,
      "end_ms": 62500,
      "id": "e_034",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I didn't ask this church for permission to survive, Father.\"",
      "speaker": "JULIANA",
      "delivery": "Fierce, Defiant",
      "source_lines": [
        146,
        148
      ]
    },
    {
      "start_ms": 62800,
      "end_ms": 65800,
      "id": "e_035",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium two-shot of Juliana standing proudly beside Alexander.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        150,
        152
      ]
    },
    {
      "start_ms": 62900,
      "end_ms": 65500,
      "id": "e_036",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I won't ask it for permission to love.\"",
      "speaker": "JULIANA",
      "delivery": "Passionate, Resolute",
      "source_lines": [
        154,
        156
      ]
    },
    {
      "start_ms": 65800,
      "end_ms": 71000,
      "id": "e_037",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the High Priest looking down, a sinister, condescending smirk gracing his lips.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        158,
        160
      ]
    },
    {
      "start_ms": 66800,
      "end_ms": 70500,
      "id": "e_038",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Love doesn't make a Duchess, girl. Paper does.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Condescending, Venomous",
      "source_lines": [
        162,
        164
      ]
    },
    {
      "start_ms": 71000,
      "end_ms": 76800,
      "id": "e_039",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Slow push-in medium close-up on Juliana, her voice trembling with intense indignation.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        166,
        168
      ]
    },
    {
      "start_ms": 71400,
      "end_ms": 74300,
      "id": "e_040",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Then look at this floor honestly, for once.\"",
      "speaker": "JULIANA",
      "delivery": "Accusatory, Pained",
      "source_lines": [
        170,
        172
      ]
    },
    {
      "start_ms": 74400,
      "end_ms": 76600,
      "id": "e_041",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A church called me unworthy.\"",
      "speaker": "JULIANA",
      "delivery": "Voice Breaking, Passionate",
      "source_lines": [
        174,
        176
      ]
    },
    {
      "start_ms": 76800,
      "end_ms": 78000,
      "id": "e_042",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Quick cut to the High Priest maintaining a smug, impenetrable stare.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        178,
        180
      ]
    },
    {
      "start_ms": 76800,
      "end_ms": 78000,
      "id": "e_043",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A church chained me.\"",
      "speaker": "JULIANA",
      "delivery": "O.S.) (Bitter",
      "source_lines": [
        182,
        184
      ]
    },
    {
      "start_ms": 78000,
      "end_ms": 85800,
      "id": "e_044",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Extreme close-up on Juliana's face as she shouts at the priest.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        186,
        188
      ]
    },
    {
      "start_ms": 78100,
      "end_ms": 81000,
      "id": "e_045",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Now a church calls my marriage a lie!\"",
      "speaker": "JULIANA",
      "delivery": "Furious, Resolute",
      "source_lines": [
        190,
        192
      ]
    },
    {
      "start_ms": 81100,
      "end_ms": 85500,
      "id": "e_046",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"God married us, Father! You are just angry no one asked you first!\"",
      "speaker": "JULIANA",
      "delivery": "Shouting, Triumphant",
      "source_lines": [
        194,
        196
      ]
    },
    {
      "start_ms": 85800,
      "end_ms": 89200,
      "id": "e_047",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Catherine leaning against a stone archway, whispering with venomous mockery.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        198,
        200
      ]
    },
    {
      "start_ms": 86100,
      "end_ms": 89000,
      "id": "e_048",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Careful, healer. The floor isn't finished with you.\"",
      "speaker": "CATHERINE",
      "delivery": "Malicious, Taunting",
      "source_lines": [
        202,
        204
      ]
    },
    {
      "start_ms": 89200,
      "end_ms": 92500,
      "id": "e_049",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of the High Priest pressing the document against his chest, his eyes darkening with anger.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        206,
        208
      ]
    },
    {
      "start_ms": 89300,
      "end_ms": 92400,
      "id": "e_050",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Careful, girl. You mistake my patience for weakness.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "O.S. / Low, Threatening",
      "source_lines": [
        210,
        212
      ]
    },
    {
      "start_ms": 92500,
      "end_ms": 96000,
      "id": "e_051",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot of the High Priest stepping up the altar steps toward them.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        214,
        216
      ]
    },
    {
      "start_ms": 92200,
      "end_ms": 96200,
      "id": "e_052",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"God did not marry you. A frightened parishioner did, without leave, without license, without the Crown's blessing!\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Commanding, Severe",
      "source_lines": [
        218,
        220
      ]
    },
    {
      "start_ms": 96000,
      "end_ms": 96800,
      "id": "e_053",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Brief insert of Catherine smirking as she watches from the side.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        222,
        224
      ]
    },
    {
      "start_ms": 96800,
      "end_ms": 100500,
      "id": "e_054",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide shot of the High Priest waving the letter overhead before the congregation.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        226,
        228
      ]
    },
    {
      "start_ms": 96800,
      "end_ms": 100400,
      "id": "e_055",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"And I have the power to undo in one hearing what took you three years to steal!\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Booming, Threatening",
      "source_lines": [
        230,
        232
      ]
    },
    {
      "start_ms": 100500,
      "end_ms": 101800,
      "id": "e_056",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Catherine listening eagerly.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        234,
        236
      ]
    },
    {
      "start_ms": 101800,
      "end_ms": 106800,
      "id": "e_057",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Profile medium shot of Alexander confronting the High Priest face-to-face at the foot of the altar.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        238,
        240
      ]
    },
    {
      "start_ms": 101800,
      "end_ms": 106500,
      "id": "e_058",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A Duke's marriage is judged by the Crown's peerage court, not by a parish priest's seal.\"",
      "speaker": "ALEXANDER",
      "delivery": "Cold, Resolute",
      "source_lines": [
        242,
        244
      ]
    },
    {
      "start_ms": 106800,
      "end_ms": 111800,
      "id": "e_059",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle two-shot of the High Priest staring up into Alexander's imposing frame.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        246,
        248
      ]
    },
    {
      "start_ms": 107000,
      "end_ms": 111500,
      "id": "e_060",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"The High Religious Council rules on matters of holy matrimony. That includes yours.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Stern, Unflinching",
      "source_lines": [
        250,
        252
      ]
    },
    {
      "start_ms": 111800,
      "end_ms": 118500,
      "id": "e_061",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Alexander glaring with icy authority.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        254,
        256
      ]
    },
    {
      "start_ms": 112000,
      "end_ms": 118200,
      "id": "e_062",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Then let it prove that in ten days, before witnesses. Not with six halberds pointed at me in my own chapel.\"",
      "speaker": "ALEXANDER",
      "delivery": "Defiant, Commanding",
      "source_lines": [
        258,
        260
      ]
    },
    {
      "start_ms": 118500,
      "end_ms": 124000,
      "id": "e_063",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide profile two-shot of the High Priest and Alexander locked in an intense standoff before the altar.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        262,
        264
      ]
    },
    {
      "start_ms": 118800,
      "end_ms": 123600,
      "id": "e_064",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Ten days. And if the council rules against you, this county watches you lose her twice.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Chilling, Victorious",
      "source_lines": [
        266,
        268
      ]
    },
    {
      "start_ms": 124000,
      "end_ms": 126500,
      "id": "e_065",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I'll take that wager over your decree.\"",
      "speaker": "ALEXANDER",
      "delivery": "Steely, Unfazed",
      "source_lines": [
        270,
        272
      ]
    },
    {
      "start_ms": 126500,
      "end_ms": 127200,
      "id": "e_066",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Quick reaction shot of the elderly woman in the pew gripping her beads in distress.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        274,
        276
      ]
    },
    {
      "start_ms": 127200,
      "end_ms": 133500,
      "id": "e_067",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide shot from behind the guards as they surround Alexander and Juliana, halberds and swords pointed inches from Alexander's chest.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        278,
        280
      ]
    },
    {
      "start_ms": 127200,
      "end_ms": 133200,
      "id": "e_068",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Lower them! Or explain to the Crown why its own bailiffs raised iron on the Duke it just confirmed!\"",
      "speaker": "ALEXANDER",
      "delivery": "Thunderous, Imposing",
      "source_lines": [
        282,
        284
      ]
    },
    {
      "start_ms": 133500,
      "end_ms": 138800,
      "id": "e_069",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of the High Priest extending his hand toward the guards, commanding them to stand down.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        286,
        288
      ]
    },
    {
      "start_ms": 134000,
      "end_ms": 136000,
      "id": "e_070",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The guards slowly lower their weapon points away from the Duke.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        290,
        292
      ]
    },
    {
      "start_ms": 134200,
      "end_ms": 138500,
      "id": "e_071",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Ten days, Duke. Choose your witnesses well.\"",
      "speaker": "HIGH PRIEST",
      "delivery": "Ominous, Warning",
      "source_lines": [
        294,
        296
      ]
    },
    {
      "start_ms": 138800,
      "end_ms": 140500,
      "id": "e_072",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "The High Priest turns sharply on his heel and strides past the guards toward the church exit.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        298,
        300
      ]
    },
    {
      "start_ms": 139000,
      "end_ms": 142000,
      "id": "e_073",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "Shuffling boots and clattering armor as the royal guards turn and retreat down the ruined aisle.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        302,
        304
      ]
    },
    {
      "start_ms": 140500,
      "end_ms": 143880,
      "id": "e_074",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Slow pan to Catherine standing in her bridal gown beside the sunlit aisle, watching the priest depart before turning to camera with a wicked, predatory smile.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        306,
        308
      ]
    },
    {
      "start_ms": 141200,
      "end_ms": 143800,
      "id": "e_075",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Ten days is plenty of time.\"",
      "speaker": "CATHERINE",
      "delivery": "Whispering, Malicious",
      "source_lines": [
        310,
        312
      ]
    }
  ],
