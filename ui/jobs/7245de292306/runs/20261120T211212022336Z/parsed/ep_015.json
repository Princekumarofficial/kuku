        14,
        16
      ]
    },
    {
      "start_ms": 0,
      "end_ms": 3500,
      "id": "e_002",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Three menacing thugs, armed with clubs and tools, stalk through the quiet herbal garden surrounded by stone walls.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        18,
        20
      ]
    },
    {
      "start_ms": 3500,
      "end_ms": 5000,
      "id": "e_003",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle medium shot focusing on one thug raising a heavy wooden club overhead.",
