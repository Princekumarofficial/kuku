      "delivery": null,
      "source_lines": [
        22,
        24
      ]
    },
    {
      "start_ms": 3600,
      "end_ms": 4900,
      "id": "e_004",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The thug brutally smashes his club down into a wooden planter box, shattering the frame.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        26,
        28
      ]
    },
    {
      "start_ms": 3800,
      "end_ms": 4900,
      "id": "e_005",
      "scene_id": "sc_001",
      "type": "sound",
      "text": "A splintering wooden crash echoing through the night air.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        30,
        32
      ]
    },
    {
      "start_ms": 5000,
      "end_ms": 7500,
      "id": "e_006",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of a bald thug leaning over a lush bed of white medicinal chamomile herbs.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 5100,
      "end_ms": 7400,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The bald thug roughly rips a massive handful of flowering herbs up by their roots, scattering soil across the path.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 7500,
      "end_ms": 11800,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot framing the open doorway of the stone cottage, bathed in warm interior light against the dark night.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        42,
        44
      ]
    },
    {
      "start_ms": 7600,
      "end_ms": 11800,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana bursts through the cottage doorway, her hands wrapped in clean white bandages, freezing in horror at the destruction.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 8500,
      "end_ms": 11700,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Stop! What are you doing?!\"",
      "speaker": "JULIANA",
      "delivery": "Desperate, Alarmed",
      "source_lines": [
        50,
        52
      ]
    },
    {
      "start_ms": 11800,
      "end_ms": 15800,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of the Thug with Cap holding the uprooted chamomile bouquet, sneering with cruel amusement.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 13000,
      "end_ms": 15700,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"We're clearing this rubbish.\"",
      "speaker": "THUG WITH CAP",
      "delivery": "Mocking, Smug",
      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 15800,
      "end_ms": 18800,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up on Juliana, her face tight with anguish and fury as she clutches her bandaged hands against her chest.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 16400,
      "end_ms": 18700,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Those are medicinal plants!\"",
      "speaker": "JULIANA",
      "delivery": "Furious, Pleading",
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 18800,
      "end_ms": 22500,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle shot tracking down from the bald thug's grinning face to his worn leather boots on the muddy flagstones.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 20000,
      "end_ms": 22300,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"They look like weeds to me.\"",
      "speaker": "BALD THUG",
      "delivery": "Callous",
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 20500,
      "end_ms": 22500,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The bald thug flings the bouquet into the mud and grinds his heavy boot directly onto the delicate flowers.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 22500,
      "end_ms": 26800,
      "id": "e_018",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "High-angle two-shot as Juliana rushes forward and drops directly onto her knees in the cold mud before the thug.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        82,
        84
      ]
    },
    {
      "start_ms": 22800,
      "end_ms": 26500,
      "id": "e_019",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana frantically tries to scoop the crushed soil and torn stems back into the bed with her bandaged hands.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        86,
        88
      ]
    },
    {
      "start_ms": 23200,
      "end_ms": 26300,
      "id": "e_020",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Please! Those plants took months to grow!\"",
      "speaker": "JULIANA",
      "delivery": "Choked with Tears, Desperate",
      "source_lines": [
        90,
        92
      ]
    },
    {
      "start_ms": 26800,
      "end_ms": 31500,
      "id": "e_021",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium two-shot of the Tall Thug with the club and the Thug with Cap bursting into raucous laughter under the full moon.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        94,
        96
      ]
    },
    {
      "start_ms": 27500,
      "end_ms": 31200,
      "id": "e_022",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Months? You actually spend your days growing this filth?\"",
      "speaker": "TALL THUG",
      "delivery": "Contemptuous, Derisive",
      "source_lines": [
        98,
        100
      ]
    },
    {
      "start_ms": 31500,
      "end_ms": 34000,
      "id": "e_023",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Tight close-up of Juliana's bandaged hands trembling as she tenderly gathers the soiled white flowers from the puddles.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        102,
        104
      ]
    },
    {
      "start_ms": 34000,
      "end_ms": 37000,
      "id": "e_024",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle medium shot tilting up as Juliana rises from the ground, standing tall despite her trembling frame.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        106,
        108
      ]
    },
    {
      "start_ms": 34800,
      "end_ms": 36800,
      "id": "e_025",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Leave my garden alone.\"",
      "speaker": "JULIANA",
      "delivery": "Defiant, Firm",
      "source_lines": [
        110,
        112
      ]
    },
    {
      "start_ms": 37000,
      "end_ms": 40500,
      "id": "e_026",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of the Thug with Cap scoffing derisively.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        114,
        116
      ]
    },
    {
      "start_ms": 37200,
      "end_ms": 40400,
      "id": "e_027",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A noble lady playing in the dirt. What a joke.\"",
      "speaker": "THUG WITH CAP",
      "delivery": "Sneering, Disdainful",
      "source_lines": [
        118,
        120
      ]
    },
    {
      "start_ms": 40500,
      "end_ms": 44200,
      "id": "e_028",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Juliana, her eyes blazing with indignation and wounded pride.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        122,
        124
      ]
    },
    {
      "start_ms": 41000,
      "end_ms": 44000,
      "id": "e_029",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"It is my home. You have no right to destroy anything here.\"",
      "speaker": "JULIANA",
      "delivery": "Resolute, Dignified",
      "source_lines": [
        126,
        128
      ]
    },
    {
      "start_ms": 44200,
      "end_ms": 46500,
      "id": "e_030",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Tight close-up of the Thug with Cap stepping aggressively into Juliana's personal space, snarling with venom.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        130,
        132
      ]
    },
    {
      "start_ms": 44800,
      "end_ms": 46400,
      "id": "e_031",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Get out of the way!\"",
      "speaker": "THUG WITH CAP",
      "delivery": "Menacing Snarl",
      "source_lines": [
        134,
        136
      ]
    },
    {
      "start_ms": 46500,
      "end_ms": 48000,
      "id": "e_032",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Extreme close-up on Juliana's piercing blue eyes and set jaw, unflinching.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        138,
        140
      ]
    },
    {
      "start_ms": 46500,
      "end_ms": 47300,
      "id": "e_033",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"No.\"",
      "speaker": "JULIANA",
      "delivery": "Steely, Fearless",
      "source_lines": [
        142,
        144
      ]
    },
    {
      "start_ms": 47400,
      "end_ms": 49500,
      "id": "e_034",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The Thug with Cap violently shoves Juliana back with both hands; she cries out as she loses her balance and crashes hard onto the wet stone path.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        146,
        148
      ]
    },
    {
      "start_ms": 47800,
      "end_ms": 49000,
      "id": "e_035",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Ah!\"",
      "speaker": "JULIANA",
      "delivery": "Gasping Cry",
      "source_lines": [
        150,
        152
      ]
    },
    {
      "start_ms": 49500,
      "end_ms": 53500,
      "id": "e_036",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up tracking down to Juliana's hand hitting the mud next to the crushed chamomile flowers.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        154,
        156
      ]
    },
    {
      "start_ms": 50000,
      "end_ms": 53500,
      "id": "e_037",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana crawls forward on her elbows; fresh crimson blood seeps profusely through her white gauze bandages as she reaches for the ruined blossoms.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        158,
        160
      ]
    },
    {
      "start_ms": 53500,
      "end_ms": 56500,
      "id": "e_038",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Tight close-up on Juliana's mud-streaked, tear-stained face trembling in heartbreaking agony.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        162,
        164
      ]
    },
    {
      "start_ms": 53500,
      "end_ms": 55700,
      "id": "e_039",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"My mother's plants...\"",
      "speaker": "JULIANA",
      "delivery": "Broken, Sobbing",
      "source_lines": [
        166,
        168
      ]
    },
    {
      "start_ms": 56500,
      "end_ms": 60000,
      "id": "e_040",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle wide shot of the three thugs pointing and laughing hysterically at her kneeling form.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        170,
        172
      ]
    },
    {
      "start_ms": 57300,
      "end_ms": 59800,
      "id": "e_041",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Look at her! Crying over weeds!\"",
      "speaker": "BALD THUG",
      "delivery": "Cruel, Laughing",
      "source_lines": [
        174,
        176
      ]
    },
    {
      "start_ms": 60000,
      "end_ms": 62000,
      "id": "e_042",
      "scene_id": "sc_001",
      "type": "action",
      "text": "The Tall Thug hoists his heavy wooden club above his head to crush the remaining herbs right before Juliana.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        178,
        180
      ]
    },
    {
      "start_ms": 60000,
      "end_ms": 61000,
      "id": "e_043",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Stop!\"",
      "speaker": "JULIANA",
      "delivery": "Screaming",
      "source_lines": [
        182,
        184
      ]
    },
    {
      "start_ms": 62000,
      "end_ms": 63200,
      "id": "e_044",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of the Thug with Cap suddenly stiffening, his smug smile dropping as footsteps pound in the darkness.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        186,
        188
      ]
    },
    {
      "start_ms": 63200,
      "end_ms": 67500,
      "id": "e_045",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium tracking shot as Alexander charges past the corner of the cottage into the misty moonlight, his dark coat billowing behind him.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        190,
        192
      ]
    },
    {
      "start_ms": 63500,
      "end_ms": 67500,
      "id": "e_046",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Alexander storms forward with lethal intensity, dark hair flying, breath misting in the cold, radiating untamed rage.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        194,
        196
      ]
    },
    {
      "start_ms": 67500,
      "end_ms": 73500,
      "id": "e_047",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana looking up through wet lashes, trembling as shock transforms into overwhelming relief.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        198,
        200
      ]
    },
    {
      "start_ms": 70500,
      "end_ms": 72600,
      "id": "e_048",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Alexander...\"",
      "speaker": "JULIANA",
      "delivery": "Whispered Breath, Stunned",
      "source_lines": [
        202,
        204
      ]
    },
    {
      "start_ms": 73500,
      "end_ms": 75500,
      "id": "e_049",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide shot of the three thugs wheeling around to face the dark figure approaching from the mist.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        206,
        208
      ]
    },
    {
      "start_ms": 75500,
      "end_ms": 78500,
      "id": "e_050",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Low-angle tracking shot from behind Alexander's broad shoulders as he steadily steps past the fallen Juliana, towering over the intruders.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        210,
        212
      ]
    },
    {
      "start_ms": 76000,
      "end_ms": 78500,
      "id": "e_051",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Alexander places himself directly between Juliana and the three thugs, staring them down with cold, deadly intent.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        214,
        216
      ]
    },
    {
      "start_ms": 78500,
      "end_ms": 82800,
      "id": "e_052",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of the three thugs regrouping, the Thug with Cap feigning swagger as he grips his club.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        218,
        220
      ]
    },
    {
      "start_ms": 79000,
      "end_ms": 82400,
      "id": "e_053",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"What? You want to fight us, veteran?\"",
      "speaker": "THUG WITH CAP",
      "delivery": "Challenging, Arrogant",
      "source_lines": [
        222,
        224
      ]
    },
    {
