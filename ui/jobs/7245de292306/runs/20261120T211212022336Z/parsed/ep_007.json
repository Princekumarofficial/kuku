      "end_ms": 78500,
      "id": "e_038",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Low shot of the Scarred Bearded Man bending down and dropping the bundle of logs by the stone wall.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        176,
        178
      ]
    },
    {
      "start_ms": 76200,
      "end_ms": 77500,
      "id": "e_039",
      "scene_id": "sc_003",
      "type": "sound",
      "text": "A dull, heavy thud of timber striking the mud.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        180,
        182
      ]
    },
    {
      "start_ms": 78500,
      "end_ms": 81000,
      "id": "e_040",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Medium full shot as the Scarred Bearded Man straightens to his full imposing height and steps directly toward Gerald.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        184,
        186
      ]
    },
    {
      "start_ms": 81000,
      "end_ms": 83500,
      "id": "e_041",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Two-shot framing the Scarred Bearded Man towering menacingly over Gerald, staring down at him with unyielding intensity.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        188,
        190
      ]
    },
    {
      "start_ms": 81500,
      "end_ms": 84000,
      "id": "e_042",
      "scene_id": "sc_003",
      "type": "action",
      "text": "Gerald freezes, his arrogant bravado instantly vanishing as cold dread overtakes his face.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        192,
        194
      ]
    },
    {
      "start_ms": 83500,
      "end_ms": 88000,
      "id": "e_043",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Low-angle close-up of Gerald looking up in sheer terror, his adam's apple bobbing nervously.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        196,
        198
      ]
    },
    {
      "start_ms": 86500,
      "end_ms": 88500,
      "id": "e_044",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"Gerald, don't let him frighten you.\"",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": "O.S.) (Urgent, Annoyed",
      "source_lines": [
        200,
        202
      ]
    },
    {
      "start_ms": 88600,
      "end_ms": 90000,
      "id": "e_045",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"What are you staring at?\"",
      "speaker": "GERALD",
      "delivery": "Trembling, Trying to Save Face",
      "source_lines": [
        204,
        206
      ]
    },
    {
      "start_ms": 90000,
      "end_ms": 91500,
      "id": "e_046",
      "scene_id": "sc_003",
      "type": "action",
      "text": "Gerald rapidly turns on his heel toward the carriage, unwilling to face another second of the silent glare.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        208,
        210
      ]
    },
    {
      "start_ms": 90100,
      "end_ms": 91400,
      "id": "e_047",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"We are leaving.\"",
      "speaker": "GERALD",
      "delivery": "Nervous, Hurried",
      "source_lines": [
        212,
        214
      ]
    },
    {
      "start_ms": 91500,
      "end_ms": 93800,
      "id": "e_048",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Medium shot of Aristocratic Woman, shocked and indignant as Gerald flees past her.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        216,
        218
      ]
    },
    {
      "start_ms": 92000,
      "end_ms": 93800,
      "id": "e_049",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"Leaving? Gerald!\"",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": "Outraged, Flustered",
      "source_lines": [
        220,
        222
      ]
    },
    {
      "start_ms": 93800,
      "end_ms": 96500,
      "id": "e_050",
      "scene_id": "sc_003",
      "type": "action",
      "text": "Aristocratic Woman scrambles back into the carriage, hiking up her gown in a fluster before slamming the door shut.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        224,
        226
      ]
    },
    {
      "start_ms": 95000,
      "end_ms": 96000,
      "id": "e_051",
      "scene_id": "sc_003",
      "type": "sound",
      "text": "Carriage door slamming shut.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        228,
        230
      ]
    },
    {
      "start_ms": 96000,
      "end_ms": 99000,
      "id": "e_052",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Wide shot of the carriage rapidly jolting forward and disappearing down the misty road away from the cottage.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        232,
        234
      ]
    },
    {
      "start_ms": 99000,
      "end_ms": 103500,
      "id": "e_053",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Medium profile two-shot of Juliana turning toward the Scarred Bearded Man, her eyes gleaming with genuine admiration.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        236,
        238
      ]
    },
    {
      "start_ms": 100800,
      "end_ms": 103200,
      "id": "e_054",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"You didn't say a word.\"",
      "speaker": "JULIANA",
      "delivery": "Impressed, Softly Amused",
      "source_lines": [
        240,
        242
      ]
    },
    {
      "start_ms": 103500,
      "end_ms": 107500,
      "id": "e_055",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Close-up on the Scarred Bearded Man looking down at her, his rugged features softening with quiet affection.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        244,
        246
      ]
    },
    {
      "start_ms": 106000,
      "end_ms": 107800,
      "id": "e_056",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"I didn't need to.\"",
      "speaker": "SCARRED BEARDED MAN",
      "delivery": "Low, Gentle, Confident",
      "source_lines": [
        248,
        250
      ]
    },
