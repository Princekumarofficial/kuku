      "delivery": null,
      "source_lines": [
        34,
        36
      ]
    },
    {
      "start_ms": 19500,
      "end_ms": 21000,
      "id": "e_007",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Aristocratic Woman smirks cruelly as she surveys the humble stone cottage.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        38,
        40
      ]
    },
    {
      "start_ms": 21000,
      "end_ms": 24000,
      "id": "e_008",
      "scene_id": "sc_001",
      "type": "action",
      "text": "Juliana rinses the heavy mud from her hands in a cold rainwater puddle and rises to her feet, holding her head high.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        42,
        44
      ]
    },
    {
      "start_ms": 22000,
      "end_ms": 24500,
      "id": "e_009",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"This is where you live now?\"",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": "Mocking, Condescending",
      "source_lines": [
        46,
        48
      ]
    },
    {
      "start_ms": 24500,
      "end_ms": 29800,
      "id": "e_010",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium shot of Gerald standing beside Aristocratic Woman, sneering disdainfully.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        50,
        52
      ]
    },
    {
      "start_ms": 25000,
      "end_ms": 29800,
      "id": "e_011",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"A fitting home for a woman who threw away everything for a penniless soldier.\"",
      "speaker": "GERALD",
      "delivery": "Arrogant, Scornful",
      "source_lines": [
        54,
        56
      ]
    },
    {
      "start_ms": 29800,
      "end_ms": 32800,
      "id": "e_012",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Juliana, defiant and unflinching despite her soiled dress and damp hair.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        58,
        60
      ]
    },
    {
      "start_ms": 30000,
      "end_ms": 32600,
      "id": "e_013",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You came all this way just to insult my home?\"",
      "speaker": "JULIANA",
      "delivery": "Sharp, Unintimidated",
      "source_lines": [
        62,
        64
      ]
    },
    {
      "start_ms": 32800,
      "end_ms": 37500,
      "id": "e_014",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Aristocratic Woman erupting into high-pitched, malicious laughter beneath her parasol.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        66,
        68
      ]
    },
    {
      "start_ms": 33200,
      "end_ms": 37800,
      "id": "e_015",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"Home? Look at your hands, Juliana.\"",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": "Gloating, Mocking",
      "source_lines": [
        70,
        72
      ]
    },
    {
      "start_ms": 37800,
      "end_ms": 39800,
      "id": "e_016",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Juliana's mud-stained palms held open against her apron.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        74,
        76
      ]
    },
    {
      "start_ms": 38200,
      "end_ms": 39800,
      "id": "e_017",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You look like a servant.\"",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": "O.S.) (Cruel",
      "source_lines": [
        78,
        80
      ]
    },
    {
      "start_ms": 39800,
      "end_ms": 41000,
      "id": "e_018",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Gerald's smug expression watching Juliana.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        82,
        84
      ]
    },
    {
      "start_ms": 41000,
      "end_ms": 45000,
      "id": "e_019",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Medium close-up of Juliana lifting her chin with unwavering dignity.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        86,
        88
      ]
    },
    {
      "start_ms": 41200,
      "end_ms": 44800,
      "id": "e_020",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I work with my hands. There is no shame in that.\"",
      "speaker": "JULIANA",
      "delivery": "Proud, Resolute",
      "source_lines": [
        90,
        92
      ]
    },
    {
      "start_ms": 45000,
      "end_ms": 47000,
      "id": "e_021",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up on Gerald's tightening jaw.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        94,
        96
      ]
    },
    {
      "start_ms": 45200,
      "end_ms": 46800,
      "id": "e_022",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You were born a lady.\"",
      "speaker": "GERALD",
      "delivery": "Biting, Condescending",
      "source_lines": [
        98,
        100
      ]
    },
    {
      "start_ms": 47000,
      "end_ms": 50800,
      "id": "e_023",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up on Juliana's clear blue eyes, shining with unbroken pride.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        102,
        104
      ]
    },
    {
      "start_ms": 48800,
      "end_ms": 50400,
      "id": "e_024",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"And I remain one.\"",
      "speaker": "JULIANA",
      "delivery": "Firm, Unapologetic",
      "source_lines": [
        106,
        108
      ]
    },
    {
      "start_ms": 50800,
      "end_ms": 54800,
      "id": "e_025",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Wide shot framing Juliana facing off against Gerald and Aristocratic Woman in the bleak courtyard.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        110,
        112
      ]
    },
    {
      "start_ms": 51500,
      "end_ms": 54600,
      "id": "e_026",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You chose that scarred beggar over a life of comfort.\"",
      "speaker": "GERALD",
      "delivery": "Bitter, Sneering",
      "source_lines": [
        114,
        116
      ]
    },
    {
      "start_ms": 54800,
      "end_ms": 61500,
      "id": "e_027",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Two-shot profile of Juliana looking straight into Gerald's eyes without flinching.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        118,
        120
      ]
    },
    {
      "start_ms": 57800,
      "end_ms": 61000,
      "id": "e_028",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I chose a man who stood beside me when you walked away.\"",
      "speaker": "JULIANA",
      "delivery": "Passionate, Defiant",
      "source_lines": [
        122,
        124
      ]
    },
    {
      "start_ms": 61500,
      "end_ms": 65200,
      "id": "e_029",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Intense close-up of Juliana dismissing him with utter contempt.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        126,
        128
      ]
    },
    {
      "start_ms": 61800,
      "end_ms": 64800,
      "id": "e_030",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"You have no authority here. Leave.\"",
      "speaker": "JULIANA",
      "delivery": "Cold, Commanding",
      "source_lines": [
        130,
        132
      ]
    },
    {
      "start_ms": 65200,
      "end_ms": 69500,
      "id": "e_031",
      "scene_id": "sc_001",
      "type": "camera",
      "text": "Close-up of Gerald lunging forward, aggressively pointing his finger into Juliana's face.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        134,
        136
      ]
    },
    {
      "start_ms": 65600,
      "end_ms": 68500,
      "id": "e_032",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"I have enough influence to make a beggar disappear.\"",
      "speaker": "GERALD",
      "delivery": "Furious, Threatening",
      "source_lines": [
        138,
        140
      ]
    },
    {
      "start_ms": 68600,
      "end_ms": 69500,
      "id": "e_033",
      "scene_id": "sc_001",
      "type": "dialogue",
      "text": "\"And your husband?\"",
      "speaker": "GERALD",
      "delivery": "Spiteful, Boastful",
      "source_lines": [
        142,
        144
      ]
    },
    {
      "start_ms": 69500,
      "end_ms": 74000,
      "id": "e_034",
      "scene_id": "sc_002",
      "type": "camera",
      "text": "Wide shot down a dark, fog-drenched forest path. A towering, shadowed figure walks steadily forward through the mist.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        153,
        155
      ]
    },
    {
      "start_ms": 69500,
      "end_ms": 71200,
      "id": "e_035",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Where is that beggar husband?\"",
      "speaker": "GERALD",
      "delivery": "V.O.) (Snarl",
      "source_lines": [
        157,
        159
      ]
    },
    {
      "start_ms": 70000,
      "end_ms": 75500,
      "id": "e_036",
      "scene_id": "sc_002",
      "type": "action",
      "text": "The Scarred Bearded Man marches purposefully toward the cottage, carrying a heavy bundle of chopped firewood bound tightly with hemp cord.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        161,
        163
      ]
    },
