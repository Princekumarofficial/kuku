      "delivery": null,
      "source_lines": [
        205,
        207
      ]
    },
    {
      "start_ms": 83000,
      "end_ms": 87500,
      "id": "e_048",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"Juliana's ruin will be a lesson. And we will be there to watch.\"",
      "speaker": "LADY CLARISSA",
      "delivery": "Smug Triumph",
      "source_lines": [
        209,
        211
      ]
    },
    {
