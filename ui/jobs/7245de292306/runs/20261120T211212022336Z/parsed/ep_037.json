      "delivery": null,
      "source_lines": [
        228,
        230
      ]
    },
    {
      "start_ms": 93500,
      "end_ms": 95500,
      "id": "e_052",
      "scene_id": "sc_003",
      "type": "action",
      "text": "Juliana curls her fingers back, pulling away from the foul sustenance in defiance.",
