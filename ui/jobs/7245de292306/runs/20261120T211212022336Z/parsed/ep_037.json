      "start_ms": 73000,
      "end_ms": 74200,
      "id": "e_044",
      "scene_id": "sc_002",
      "type": "dialogue",
      "text": "\"To whom?\"",
      "speaker": "NOBLEMAN",
      "delivery": "Curious",
      "source_lines": [
        193,
        195
      ]
    },
