      "delivery": null,
      "source_lines": [
        236,
        238
      ]
    },
    {
      "start_ms": 96000,
      "end_ms": 99500,
      "id": "e_054",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"They think hunger will make me surrender.\"",
      "speaker": "JULIANA",
      "delivery": "Weak, Whispering through Tears",
      "source_lines": [
        240,
        242
      ]
    },
    {
      "start_ms": 100500,
      "end_ms": 103500,
      "id": "e_055",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Extreme close-up of Juliana's blue eyes snapping open, blazing with unyielding defiance.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        244,
        246
      ]
    },
    {
      "start_ms": 100800,
      "end_ms": 103200,
      "id": "e_056",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"They think fear will make me beg.\"",
      "speaker": "JULIANA",
      "delivery": "Fierce Resolve",
      "source_lines": [
        248,
        250
      ]
    },
