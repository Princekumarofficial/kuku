      "delivery": null,
      "source_lines": [
        252,
        254
      ]
    },
    {
      "start_ms": 104000,
      "end_ms": 107000,
      "id": "e_058",
      "scene_id": "sc_003",
      "type": "sound",
      "text": "The harsh scrape and clatter of heavy iron chains dragging across wet stone.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        256,
        258
      ]
    },
    {
      "start_ms": 105500,
      "end_ms": 107800,
      "id": "e_059",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"I will not!\"",
      "speaker": "JULIANA",
      "delivery": "Straining, Defiant Gasps",
      "source_lines": [
        260,
        262
      ]
    },
    {
      "start_ms": 108500,
      "end_ms": 113500,
      "id": "e_060",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Low-angle shot looking up at Juliana as she thrusts her chin high toward the iron ceiling grate, bathed in cold shafts of light.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        264,
        266
      ]
    },
    {
      "start_ms": 109000,
      "end_ms": 112500,
      "id": "e_061",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"They can take my name. They can take my home.\"",
      "speaker": "JULIANA",
      "delivery": "Passionate Defiance",
      "source_lines": [
        268,
        270
      ]
    },
    {
      "start_ms": 113500,
      "end_ms": 116500,
      "id": "e_062",
      "scene_id": "sc_003",
      "type": "camera",
      "text": "Tight close-up of Juliana's iron-shackled hand reaching out and gripping the massive iron ring anchored into the dungeon pillar with crushing determination.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        272,
        274
      ]
    },
    {
      "start_ms": 113600,
      "end_ms": 116200,
      "id": "e_063",
      "scene_id": "sc_003",
      "type": "dialogue",
      "text": "\"They cannot take who I am!\"",
      "speaker": "JULIANA",
      "delivery": "Indomitable Spirit",
      "source_lines": [
        276,
        278
      ]
    },
    {
      "start_ms": 116500,
      "end_ms": 120000,
      "id": "e_064",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Medium two-shot in the dimly lit parlor, illuminated by the warm glow of the fireplace. Clarissa now wears a deep blue velvet gown, reclining in an armchair beside the nobleman.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        287,
        289
      ]
    },
    {
      "start_ms": 117200,
      "end_ms": 119800,
      "id": "e_065",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"Do you think she'll actually be executed?\"",
      "speaker": "NOBLEMAN",
      "delivery": "Quietly Skeptical",
      "source_lines": [
        291,
        293
      ]
    },
    {
      "start_ms": 120000,
      "end_ms": 124500,
      "id": "e_066",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Close-up of Clarissa giving a slight, dismissive scoff before turning to him with cold certainty.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        295,
        297
      ]
    },
    {
      "start_ms": 120500,
      "end_ms": 124200,
      "id": "e_067",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"After what she has been accused of? Of course.\"",
      "speaker": "LADY CLARISSA",
      "delivery": "Dismissive, Certain",
      "source_lines": [
        299,
        301
      ]
    },
    {
      "start_ms": 124500,
      "end_ms": 127000,
      "id": "e_068",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Medium close-up of the nobleman looking down pensively at the open execution clause on the table.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        303,
        305
      ]
    },
    {
      "start_ms": 124800,
      "end_ms": 126500,
      "id": "e_069",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"She was always stubborn.\"",
      "speaker": "NOBLEMAN",
      "delivery": "Musing",
      "source_lines": [
        307,
        309
      ]
    },
    {
      "start_ms": 127000,
      "end_ms": 132500,
      "id": "e_070",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Close-up on Clarissa's face hardening with bitter resentment.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        311,
        313
      ]
    },
    {
      "start_ms": 127500,
      "end_ms": 132000,
      "id": "e_071",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"That was her greatest mistake. She could have accepted what happened. She could have disappeared quietly.\"",
      "speaker": "LADY CLARISSA",
      "delivery": "Bitter, Cold",
      "source_lines": [
        315,
        317
      ]
    },
    {
      "start_ms": 132500,
      "end_ms": 136000,
      "id": "e_072",
      "scene_id": "sc_004",
      "type": "action",
      "text": "Clarissa rises from her armchair holding a cut crystal glass filled with dark red wine, pacing toward the fireplace.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        319,
        321
      ]
    },
    {
      "start_ms": 132500,
      "end_ms": 141500,
      "id": "e_073",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Medium tracking shot showing Clarissa standing tall beside her husband, her posture regal and vindictive.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        323,
        325
      ]
    },
    {
      "start_ms": 134000,
      "end_ms": 141000,
      "id": "e_074",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"Instead she married a nobody, played healer to peasants, challenged people above her. And now the whole county will watch her pay for it.\"",
      "speaker": "LADY CLARISSA",
      "delivery": "Venomous Monologue",
      "source_lines": [
        327,
        329
      ]
    },
    {
      "start_ms": 141500,
      "end_ms": 147500,
      "id": "e_075",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Tight close-up on Clarissa's face glowing in the firelight. Her lips curl into a merciless smile as she lifts the crystal glass to her mouth and drinks.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        331,
        333
      ]
    },
    {
      "start_ms": 142500,
      "end_ms": 146500,
      "id": "e_076",
      "scene_id": "sc_004",
      "type": "dialogue",
      "text": "\"Let them see what happens when a woman forgets her place.\"",
      "speaker": "LADY CLARISSA",
      "delivery": "Chilling Proclamation",
      "source_lines": [
        335,
        337
      ]
    },
    {
      "start_ms": 145500,
      "end_ms": 148000,
      "id": "e_077",
      "scene_id": "sc_004",
      "type": "action",
      "text": "Clarissa takes a slow sip of the red wine, her eyes gleaming with dark relish.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        339,
        341
      ]
    },
    {
      "start_ms": 147500,
      "end_ms": 156470,
      "id": "e_078",
      "scene_id": "sc_004",
      "type": "camera",
      "text": "Slow push-in on the dark polished tabletop where the open invitation lies beside the wax seal. The bold Gothic lettering \"EXECUTION CLAUSE\" sits beneath the gold crest, while the fire dances reflected on the mahogany.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        343,
        345
      ]
    },
    {
      "start_ms": 148000,
      "end_ms": 156470,
      "id": "e_079",
      "scene_id": "sc_004",
      "type": "sound",
      "text": "A deep, ominous cello rumble builds alongside the crackle of the fireplace into an unresolved, tension-filled cliffhanger sting before fading out.",
      "speaker": null,
      "delivery": null,
      "source_lines": [
        347,
        349
      ]
    }
  ],
