        "speaker": null,
        "text": "Medium close-up of the Mysterious Bearded Man holding her hands tenderly."
      },
      {
        "ref": "EP04:E76",
        "segment_index": 0,
        "relative_start_ms": 21000,
        "relative_end_ms": 22700,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"You have my protection.\""
      },
      {
        "ref": "EP04:E77",
        "segment_index": 0,
        "relative_start_ms": 23500,
        "relative_end_ms": 26300,
        "type": "camera",
        "speaker": null,
        "text": "Tight shot of the warrior's face, his eyes full of devotion."
      },
