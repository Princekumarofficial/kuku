        "ref": "EP04:E40",
        "segment_index": 0,
        "relative_start_ms": 30200,
        "relative_end_ms": 32400,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"If this is pity, take back your ring.\""
      },
      {
        "ref": "EP04:E41",
        "segment_index": 0,
        "relative_start_ms": 32400,
        "relative_end_ms": 35600,
        "type": "camera",
        "speaker": null,
        "text": "Tight close-up on Juliana's face, a tear clinging to her cheek."
      },
      {
        "ref": "EP04:E42",
        "segment_index": 0,
        "relative_start_ms": 33400,
        "relative_end_ms": 35400,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"I will not become anyone's charity.\""
      },
      {
        "ref": "EP04:E43",
        "segment_index": 0,
        "relative_start_ms": 35600,
        "relative_end_ms": 39400,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of the Mysterious Bearded Man holding her gaze directly."
      },
