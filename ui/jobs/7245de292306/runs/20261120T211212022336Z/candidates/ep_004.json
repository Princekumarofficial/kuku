        "relative_start_ms": 18100,
        "relative_end_ms": 21600,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of Juliana."
      },
      {
        "ref": "EP04:E34",
        "segment_index": 0,
        "relative_start_ms": 18600,
        "relative_end_ms": 21400,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"You don't know what my family has done to me.\""
      },
      {
        "ref": "EP04:E35",
        "segment_index": 0,
        "relative_start_ms": 21600,
        "relative_end_ms": 26400,
        "type": "camera",
        "speaker": null,
        "text": "Low-angle shot of the Mysterious Bearded Man still on one knee, framed against the stained-glass window."
      },
      {
        "ref": "EP04:E36",
        "segment_index": 0,
        "relative_start_ms": 22600,
        "relative_end_ms": 25400,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"I know they have made you stand alone.\""
      },
      {
        "ref": "EP04:E37",
        "segment_index": 0,
        "relative_start_ms": 26400,
        "relative_end_ms": 29400,
        "type": "camera",
        "speaker": null,
        "text": "Extreme close-up of the ring held in his weathered fingers, Juliana's white silk gown blurred in background."
      },
      {
        "ref": "EP04:E38",
        "segment_index": 0,
        "relative_start_ms": 26600,
        "relative_end_ms": 29100,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"You don't have to stand alone now.\""
      },
      {
        "ref": "EP04:E39",
        "segment_index": 0,
        "relative_start_ms": 29400,
        "relative_end_ms": 32400,
        "type": "camera",
        "speaker": null,
        "text": "Medium shot of Juliana, her pride flaring through her sadness."
      },
