        "segment_index": 0,
        "relative_start_ms": 13100,
        "relative_end_ms": 15400,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"Not a woman who deserves to be discarded.\""
      },
      {
        "ref": "EP04:E32",
        "segment_index": 0,
        "relative_start_ms": 15500,
        "relative_end_ms": 18100,
        "type": "camera",
        "speaker": null,
        "text": "Low-angle medium shot of Juliana bending slightly forward, shaken by his words."
