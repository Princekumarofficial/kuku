        "segment_index": 0,
        "relative_start_ms": 0,
        "relative_end_ms": 2400,
        "type": "camera",
        "speaker": null,
        "text": "Tight close-up of Juliana's anguished face."
      },
      {
        "ref": "EP04:E20",
        "segment_index": 0,
        "relative_start_ms": 100,
        "relative_end_ms": 2400,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"You heard what they think I am.\""
      },
      {
        "ref": "EP04:E21",
        "segment_index": 0,
        "relative_start_ms": 2400,
        "relative_end_ms": 4500,
        "type": "camera",
        "speaker": null,
        "text": "Medium shot looking down as Juliana addresses the kneeling stranger directly."
      },
      {
        "ref": "EP04:E22",
        "segment_index": 0,
        "relative_start_ms": 2500,
        "relative_end_ms": 4300,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"Why would you offer me your name?\""
      },
      {
        "ref": "EP04:E23",
        "segment_index": 0,
        "relative_start_ms": 4500,
        "relative_end_ms": 7100,
        "type": "camera",
        "speaker": null,
        "text": "Low-angle close-up of the Mysterious Bearded Man."
      },
      {
        "ref": "EP04:E24",
        "segment_index": 0,
        "relative_start_ms": 4600,
        "relative_end_ms": 6800,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"Because I know what I see.\""
      },
      {
        "ref": "EP04:E25",
        "segment_index": 0,
        "relative_start_ms": 7100,
        "relative_end_ms": 8600,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of Juliana reacting with a mix of suspicion and wonder."
      },
