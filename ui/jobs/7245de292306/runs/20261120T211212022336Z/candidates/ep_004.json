        "ref": "EP04:E44",
        "segment_index": 0,
        "relative_start_ms": 36100,
        "relative_end_ms": 39100,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"It is not pity, Lady Juliana.\""
      },
      {
        "ref": "EP04:E45",
        "segment_index": 0,
        "relative_start_ms": 39400,
        "relative_end_ms": 42100,
        "type": "camera",
        "speaker": null,
        "text": "Intense tight close-up on his piercing blue-green eyes and facial scars."
      },
      {
        "ref": "EP04:E46",
        "segment_index": 0,
        "relative_start_ms": 40100,
        "relative_end_ms": 42100,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"It is a vow.\""
      }
