        "ref": "EP04:E26",
        "segment_index": 0,
        "relative_start_ms": 8600,
        "relative_end_ms": 10400,
        "type": "camera",
        "speaker": null,
        "text": "Intimate tight shot framing Juliana's profile beside his dark silhouette."
      },
      {
        "ref": "EP04:E27",
        "segment_index": 0,
        "relative_start_ms": 8700,
        "relative_end_ms": 10300,
        "type": "dialogue",
        "speaker": "JULIANA",
        "text": "\"And what do you see?\""
      },
      {
        "ref": "EP04:E28",
        "segment_index": 0,
        "relative_start_ms": 10400,
        "relative_end_ms": 12600,
        "type": "camera",
        "speaker": null,
        "text": "Medium close-up of the Mysterious Bearded Man."
