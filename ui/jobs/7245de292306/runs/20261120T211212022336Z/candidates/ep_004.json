        "ref": "EP04:E29",
        "segment_index": 0,
        "relative_start_ms": 10600,
        "relative_end_ms": 12600,
        "type": "dialogue",
        "speaker": "MYSTERIOUS BEARDED MAN",
        "text": "\"A woman who was betrayed.\""
      },
      {
        "ref": "EP04:E30",
        "segment_index": 0,
        "relative_start_ms": 12600,
        "relative_end_ms": 15500,
        "type": "camera",
        "speaker": null,
        "text": "Over-the-shoulder shot past the bearded warrior toward Gerald watching nervously from the family pew."
      },
      {
